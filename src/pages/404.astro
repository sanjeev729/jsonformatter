---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="404: Page Not Found — JSONFormatter.AI"
  description="The requested page could not be found. Return to JSONFormatter.AI to format, validate, compare, or repair your JSON payloads 100% privately in your browser."
>
  <div class="min-h-screen flex flex-col relative overflow-hidden bg-canvas-soft transition-colors duration-200">
    <!-- Ambient background glow -->
    <div class="absolute top-[-200px] left-1/2 -translate-x-1/2 w-[800px] h-[450px] rounded-full filter blur-[120px] opacity-15 dark:opacity-20 pointer-events-none select-none z-0">
      <div class="absolute inset-0 bg-gradient-to-tr from-cyan-deep via-violet-deep to-highlight-pink"></div>
    </div>

    <Header />

    <main class="relative z-10 flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 flex flex-col items-center justify-center text-center">
      
      <!-- Breadcrumb -->
      <div class="flex items-center justify-center gap-2 mb-6 text-xs font-mono text-mute">
        <a href="/" class="hover:text-link transition-colors">Home</a>
        <span>/</span>
        <span class="text-ink font-medium">404 Error</span>
      </div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="text-caption-mono text-error font-semibold uppercase tracking-wider bg-error-soft/30 dark:bg-error-soft/20 px-3 py-1 rounded-full border border-error/30">
          ● HTTP Status 404 — Not Found
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-sans text-4xl sm:text-6xl font-extrabold text-ink tracking-tight mb-4">
        Lost in <span class="bg-gradient-to-r from-cyan-deep via-violet to-highlight-pink bg-clip-text text-transparent">Null Space?</span>
      </h1>
      <p class="font-sans text-body text-base sm:text-lg max-w-xl mx-auto leading-relaxed mb-8">
        The URL you requested could not be resolved. It may have been moved, renamed, or never existed in the first place.
      </p>

      <!-- Developer JSON Code Card -->
      <div class="w-full max-w-lg mb-10 rounded-xl bg-canvas border border-hairline shadow-level-3 text-left overflow-hidden">
        <div class="px-4 py-2.5 bg-canvas-soft-2 border-b border-hairline flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="ml-2 font-mono text-xs text-mute">error_response.json</span>
          </div>
          <span class="font-mono text-[10px] text-mute uppercase tracking-wider">JSON</span>
        </div>
        <pre class="p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto text-ink"><code>{`{`}
  <span class="text-link">"status"</span>: <span class="text-amber-600 dark:text-amber-400">404</span>,
  <span class="text-link">"error"</span>: <span class="text-emerald-600 dark:text-emerald-400">"PAGE_NOT_FOUND"</span>,
  <span class="text-link">"message"</span>: <span class="text-emerald-600 dark:text-emerald-400">"The requested endpoint does not exist."</span>,
  <span class="text-link">"privacy_status"</span>: <span class="text-emerald-600 dark:text-emerald-400">"100% Secure & Client-Side"</span>,
  <span class="text-link">"solution"</span>: <span class="text-emerald-600 dark:text-emerald-400">"Return to the JSONFormatter.AI workspace."</span>
{`}`}</code></pre>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md mb-12">
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-on-primary font-sans text-sm font-semibold hover:opacity-90 transition-all duration-200 shadow-level-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Return to Workspace</span>
        </a>
        <a 
          href="/about-us" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-canvas border border-hairline text-ink font-sans text-sm font-medium hover:bg-canvas-soft-2 transition-all duration-200 shadow-level-1"
        >
          <span>About JSONFormatter.AI</span>
        </a>
      </div>

      <!-- Quick Links Grid -->
      <div class="w-full max-w-2xl pt-8 border-t border-hairline">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-mute mb-4">
          Popular Developer Pages
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a 
            href="/" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              JSON Formatter & Validator
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              Pretty print & format raw JSON
            </div>
          </a>
          <a 
            href="/about-us" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              About & Privacy Architecture
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              100% in-browser security
            </div>
          </a>
          <a 
            href="/contact-us" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              Contact Support
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              Report issues or request features
            </div>
          </a>
        </div>
      </div>

    </main>

    <Footer />
  </div>
</Layout>
