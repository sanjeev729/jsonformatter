---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="500: Server Error — JSONFormatter.AI"
  description="An unexpected internal error occurred. Return to JSONFormatter.AI to format, validate, compare, or repair your JSON payloads 100% privately in your browser."
>
  <div class="min-h-screen flex flex-col relative overflow-hidden bg-canvas-soft transition-colors duration-200">
    <!-- Ambient background glow -->
    <div class="absolute top-[-200px] left-1/2 -translate-x-1/2 w-[800px] h-[450px] rounded-full filter blur-[120px] opacity-15 dark:opacity-20 pointer-events-none select-none z-0">
      <div class="absolute inset-0 bg-gradient-to-tr from-violet-deep via-highlight-pink to-amber-500"></div>
    </div>

    <Header />

    <main class="relative z-10 flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 flex flex-col items-center justify-center text-center">
      
      <!-- Breadcrumb -->
      <div class="flex items-center justify-center gap-2 mb-6 text-xs font-mono text-mute">
        <a href="/" class="hover:text-link transition-colors">Home</a>
        <span>/</span>
        <span class="text-ink font-medium">500 Error</span>
      </div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="text-caption-mono text-amber-600 dark:text-amber-400 font-semibold uppercase tracking-wider bg-warning-soft/30 dark:bg-warning-soft/20 px-3 py-1 rounded-full border border-warning/30">
          ● HTTP Status 500 — Internal Server Error
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-sans text-4xl sm:text-6xl font-extrabold text-ink tracking-tight mb-4">
        Unexpected <span class="bg-gradient-to-r from-amber-500 via-highlight-pink to-violet bg-clip-text text-transparent">Execution Exception</span>
      </h1>
      <p class="font-sans text-body text-base sm:text-lg max-w-xl mx-auto leading-relaxed mb-8">
        An unexpected error occurred while processing your request. Don't worry—your local browser session and JSON data remain 100% private and untouched.
      </p>

      <!-- Developer JSON Code Card -->
      <div class="w-full max-w-lg mb-10 rounded-xl bg-canvas border border-hairline shadow-level-3 text-left overflow-hidden">
        <div class="px-4 py-2.5 bg-canvas-soft-2 border-b border-hairline flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="ml-2 font-mono text-xs text-mute">uncaught_exception.json</span>
          </div>
          <span class="font-mono text-[10px] text-mute uppercase tracking-wider">JSON</span>
        </div>
        <pre class="p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto text-ink"><code>{`{`}
  <span class="text-link">"status"</span>: <span class="text-amber-600 dark:text-amber-400">500</span>,
  <span class="text-link">"error"</span>: <span class="text-error">"INTERNAL_SERVER_ERROR"</span>,
  <span class="text-link">"message"</span>: <span class="text-emerald-600 dark:text-emerald-400">"An unexpected error occurred."</span>,
  <span class="text-link">"data_safety"</span>: <span class="text-emerald-600 dark:text-emerald-400">"No local data was lost or transmitted."</span>,
  <span class="text-link">"action"</span>: <span class="text-emerald-600 dark:text-emerald-400">"Reload page or return to the workspace."</span>
{`}`}</code></pre>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md mb-12">
        <button 
          onclick="window.location.reload()" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-on-primary font-sans text-sm font-semibold hover:opacity-90 transition-all duration-200 shadow-level-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reload Page</span>
        </button>
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-canvas border border-hairline text-ink font-sans text-sm font-medium hover:bg-canvas-soft-2 transition-all duration-200 shadow-level-1"
        >
          <span>Return to Workspace</span>
        </a>
      </div>

      <!-- Quick Links Grid -->
      <div class="w-full max-w-2xl pt-8 border-t border-hairline">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-mute mb-4">
          Need Assistance?
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a 
            href="/" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              JSON Formatter
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              Reset & format raw JSON
            </div>
          </a>
          <a 
            href="/contact-us" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              Report Bug
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              Send bug report to engineering
            </div>
          </a>
          <a 
            href="/privacy-policy" 
            class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-link/40 text-left transition-all duration-200 group"
          >
            <div class="font-sans text-xs font-semibold text-ink group-hover:text-link transition-colors">
              Privacy Guarantee
            </div>
            <div class="font-sans text-[11px] text-mute mt-1">
              Read how local processing works
            </div>
          </a>
        </div>
      </div>

    </main>

    <Footer />
  </div>
</Layout>
