---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import JsonWorkspace from '../components/JsonWorkspace.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col relative overflow-hidden transition-colors duration-200">
    <!-- Ambient mesh background effects at hero scale -->
    <div class="absolute top-[-250px] left-1/2 -translate-x-1/2 w-[600px] sm:w-[900px] h-[500px] rounded-full filter blur-[120px] opacity-15 dark:opacity-20 pointer-events-none select-none z-0">
      <div class="absolute inset-0 bg-gradient-to-tr from-cyan-deep via-violet-deep to-highlight-pink scale-110 animate-mesh-1"></div>
    </div>
    
    <Header />
    
    <main class="relative z-10 flex-1 flex flex-col">
      <!-- Short Subtitle Intro -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-4 text-center select-none">
        <span class="text-caption-mono text-link font-semibold uppercase tracking-wider bg-link-bg-soft/50 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full border border-link/25 shadow-level-1">
          LOCAL SECURABLE ENVIRONMENT
        </span>
        <h1 class="font-sans text-display-lg sm:text-display-xl text-ink tracking-tight mt-4 max-w-2xl mx-auto">
          Privacy-First JSON Formatter.
        </h1>
        <p class="font-sans text-body text-sm sm:text-base max-w-lg mx-auto mt-2">
          Format, validate, diff compare, and convert your JSON payloads safely. 100% processing in-browser. Zero data transfers.
        </p>
      </section>

      <!-- Interactive Core Workspace -->
      <JsonWorkspace />
    </main>
    
    <Footer />
  </div>
</Layout>
