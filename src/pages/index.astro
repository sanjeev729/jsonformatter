---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import JsonWorkspace from '../components/JsonWorkspace.astro';
import SeoContent from '../components/SeoContent.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col relative overflow-hidden transition-colors duration-200">
    <!-- Ambient mesh background effects at hero scale -->
    <div class="absolute top-[-250px] left-1/2 -translate-x-1/2 w-[600px] sm:w-[900px] h-[500px] rounded-full filter blur-[120px] opacity-15 dark:opacity-20 pointer-events-none select-none z-0">
      <div class="absolute inset-0 bg-gradient-to-tr from-cyan-deep via-violet-deep to-highlight-pink scale-110 animate-mesh-1"></div>
    </div>
    
    <Header />
    
    <main class="relative z-10 flex-1 flex flex-col">
      <!-- Compact Subtitle Intro -->
      <section class="max-w-[1750px] w-full mx-auto px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 pb-1 sm:pb-2 flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-hairline/60 bg-canvas/30 backdrop-blur-sm select-none">
        <div class="flex items-center gap-2.5">
          <span class="text-caption-mono text-link text-[11px] font-semibold uppercase tracking-wider bg-link-bg-soft/50 dark:bg-link-bg-soft/10 px-2.5 py-0.5 rounded-full border border-link/25 shrink-0">
            SECURE SANDBOX
          </span>
          <h1 class="font-sans text-sm sm:text-base font-semibold text-ink tracking-tight truncate">
            Privacy-First JSON Formatter & Developer Toolset
          </h1>
        </div>
        <p class="font-sans text-body text-xs text-mute hidden md:block truncate">
          100% in-browser processing · Zero server transfers · Instant diff & conversion
        </p>
      </section>

      <!-- Interactive Core Workspace -->
      <JsonWorkspace />

      <!-- Comprehensive On-Page SEO Section -->
      <SeoContent />
    </main>
    
    <Footer />
  </div>
</Layout>
