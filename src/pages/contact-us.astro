---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us — JSONFormatter.AI | Get in Touch"
  description="Have questions, feature requests, or security inquiries? Contact the JSONFormatter.AI team via our interactive support form or direct email."
>
  <div class="min-h-screen flex flex-col relative overflow-hidden bg-canvas-soft transition-colors duration-200">
    <!-- Ambient background glow -->
    <div class="absolute top-[-200px] left-1/2 -translate-x-1/2 w-[700px] h-[400px] rounded-full filter blur-[120px] opacity-15 dark:opacity-20 pointer-events-none select-none z-0">
      <div class="absolute inset-0 bg-gradient-to-tr from-cyan-deep via-violet-deep to-highlight-pink"></div>
    </div>

    <Header />

    <main class="relative z-10 flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <!-- Breadcrumb & Header -->
      <div class="mb-8 border-b border-hairline pb-6">
        <div class="flex items-center gap-2 mb-3 text-xs font-mono text-mute">
          <a href="/" class="hover:text-link transition-colors">Home</a>
          <span>/</span>
          <span class="text-ink font-medium">Contact Us</span>
        </div>
        
        <div class="flex items-center gap-2.5 mb-3">
          <span class="text-caption-mono text-link text-[11px] font-semibold uppercase tracking-wider bg-link-bg-soft/50 dark:bg-link-bg-soft/10 px-2.5 py-0.5 rounded-full border border-link/25">
            Developer Support
          </span>
          <span class="text-caption-mono text-mute text-xs">Response Time: &lt; 24h</span>
        </div>

        <h1 class="font-sans text-3xl sm:text-4xl font-bold text-ink tracking-tight mb-3">
          Contact Us
        </h1>
        <p class="font-sans text-body text-base leading-relaxed text-body max-w-2xl">
          We’d love to hear from you! Send us your feedback, feature ideas, bug reports, or security inquiries.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Contact Form Card -->
        <div class="md:col-span-7 bg-canvas border border-hairline p-6 sm:p-8 rounded-xl shadow-level-1 relative">
          <h2 class="font-sans font-bold text-xl text-ink mb-4">Send a Message</h2>

          <!-- Success Alert Container -->
          <div id="contact-success" class="hidden mb-4 p-4 rounded-lg bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-400 text-sm font-sans flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Thank you! Your message has been submitted successfully. We will get back to you shortly.</span>
          </div>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block font-sans text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
                Your Name <span class="text-error">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                required 
                placeholder="Developer Name"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-sans text-sm placeholder:text-mute focus:outline-none focus:border-link focus:ring-1 focus:ring-link transition-colors"
              />
            </div>

            <div>
              <label for="contact-email" class="block font-sans text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
                Email Address <span class="text-error">*</span>
              </label>
              <input 
                type="email" 
                id="contact-email" 
                required 
                placeholder="developer@example.com"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-sans text-sm placeholder:text-mute focus:outline-none focus:border-link focus:ring-1 focus:ring-link transition-colors"
              />
            </div>

            <div>
              <label for="contact-subject" class="block font-sans text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
                Subject
              </label>
              <select 
                id="contact-subject"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-sans text-sm focus:outline-none focus:border-link focus:ring-1 focus:ring-link transition-colors"
              >
                <option value="general">General Inquiry</option>
                <option value="feature">Feature Request</option>
                <option value="bug">Bug Report / AI Repair Feedback</option>
                <option value="privacy">Privacy & Security</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block font-sans text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
                Message <span class="text-error">*</span>
              </label>
              <textarea 
                id="contact-message" 
                rows="4" 
                required 
                placeholder="Tell us how we can help or improve JSONFormatter.AI..."
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas-soft border border-hairline text-ink font-sans text-sm placeholder:text-mute focus:outline-none focus:border-link focus:ring-1 focus:ring-link transition-colors resize-y"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3 px-5 rounded-lg bg-primary text-on-primary font-sans text-sm font-semibold hover:opacity-90 transition-all duration-200 shadow-level-1 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Submit Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Channels & FAQs -->
        <div class="md:col-span-5 space-y-6">
          
          <div class="bg-canvas border border-hairline p-6 rounded-xl shadow-level-1 space-y-4">
            <h3 class="font-sans font-bold text-base text-ink">Direct Email Channels</h3>
            
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded bg-link/10 text-link flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block font-sans text-xs text-mute uppercase font-semibold">General Support</span>
                  <a href="mailto:support@jsonformatterai.com" class="font-mono text-sm text-ink hover:text-link font-medium">support@jsonformatterai.com</a>
                </div>
              </div>

              <div class="flex items-start gap-3 pt-2 border-t border-hairline">
                <div class="w-8 h-8 rounded bg-cyan-deep/10 text-cyan-deep flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <div>
                  <span class="block font-sans text-xs text-mute uppercase font-semibold">Security & Privacy</span>
                  <a href="mailto:privacy@jsonformatterai.com" class="font-mono text-sm text-ink hover:text-link font-medium">privacy@jsonformatterai.com</a>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-canvas border border-hairline p-6 rounded-xl shadow-level-1 space-y-3">
            <h3 class="font-sans font-bold text-base text-ink">Frequently Asked</h3>
            <div class="space-y-2 text-xs text-body">
              <p><strong class="text-ink">Q: Is JSONFormatter.AI free?</strong><br />Yes, completely free for personal and commercial usage.</p>
              <p><strong class="text-ink">Q: Are payloads sent to a server?</strong><br />No. All formatting runs 100% in your browser.</p>
            </div>
          </div>

        </div>

      </div>

    </main>

    <Footer />
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successBox) {
      successBox.classList.remove('hidden');
    }
    form.reset();
  });
</script>
