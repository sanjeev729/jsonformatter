---
const currentYear = new Date().getFullYear();
---
<footer class="w-full bg-canvas border-t border-hairline py-4 sm:py-5 mt-4 sm:mt-6 transition-colors duration-200">
  <div class="max-w-[1750px] mx-auto px-3 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-3 sm:gap-4">
    <!-- Brand / Security Message -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-1">
      <div class="flex items-center gap-2">
        <span class="font-sans font-semibold text-sm text-ink tracking-tight">JSONFormatter</span>
        <span class="text-caption-mono text-mute">v1.2.0</span>
      </div>
      <p class="text-xs text-mute mt-1 max-w-sm">
        Designed with privacy first. All operations, validations, and conversions run locally in your browser. No remote uploads, zero tracking.
      </p>
    </div>

    <!-- Quick Links -->
    <div class="flex flex-wrap justify-center gap-x-6 sm:gap-x-8 gap-y-2 text-xs text-body font-medium">
      <a href="#privacy" id="footer-privacy-btn" class="hover:text-ink hover:underline transition-colors duration-150">Privacy Audit</a>
      <a href="#howitworks" id="footer-how-btn" class="hover:text-ink hover:underline transition-colors duration-150">How it Works</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-ink hover:underline transition-colors duration-150 flex items-center gap-1">
        GitHub
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-[11px] text-mute font-mono">
    <span>© {currentYear} JSONFormatter Sandbox.</span>
    <span class="text-center sm:text-right">Secure Sandbox Environment (100% Offline)</span>
  </div>
</footer>
