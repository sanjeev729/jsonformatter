---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-canvas border-t border-hairline py-8 sm:py-12 mt-8 sm:mt-12 transition-colors duration-200">
  <div class="max-w-[1750px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-8 pb-8 border-b border-hairline">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 flex flex-col justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-sans font-bold text-lg text-ink tracking-tight">JSONFormatter<span class="text-link font-mono">.AI</span></span>
            <span class="text-caption-mono text-mute text-xs px-2 py-0.5 rounded-full bg-canvas-soft-2 border border-hairline">v1.2.0</span>
          </div>
          <p class="text-xs sm:text-sm text-body leading-relaxed max-w-md">
            The privacy-first developer workspace for formatting, validating, diffing, and AI-repairing JSON payloads. 100% in-browser processing with zero telemetry or remote servers.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-mute font-mono">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          <span>100% Client-Side Private Sandbox</span>
        </div>
      </div>

      <!-- Footer Nav Links Columns -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-6">
        
        <!-- Product Links -->
        <div class="space-y-3">
          <h4 class="font-sans text-xs font-semibold uppercase tracking-wider text-ink">Product</h4>
          <ul class="space-y-2 text-xs font-sans text-body">
            <li><a href="/" class="hover:text-link transition-colors">JSON Formatter</a></li>
            <li><a href="/" class="hover:text-link transition-colors">Pretty Print JSON</a></li>
            <li><a href="/" class="hover:text-link transition-colors">Compare JSON & Diff</a></li>
            <li><a href="/" class="hover:text-link transition-colors">AI Syntax Repair</a></li>
          </ul>
        </div>

        <!-- Company & Info -->
        <div class="space-y-3">
          <h4 class="font-sans text-xs font-semibold uppercase tracking-wider text-ink">Company</h4>
          <ul class="space-y-2 text-xs font-sans text-body">
            <li><a href="/about-us" class="hover:text-link transition-colors font-medium">About Us</a></li>
            <li><a href="/contact-us" class="hover:text-link transition-colors font-medium">Contact Us</a></li>
          </ul>
        </div>

        <!-- Legal & Compliance -->
        <div class="space-y-3 col-span-2 sm:col-span-1">
          <h4 class="font-sans text-xs font-semibold uppercase tracking-wider text-ink">Legal</h4>
          <ul class="space-y-2 text-xs font-sans text-body">
            <li><a href="/privacy-policy" class="hover:text-link transition-colors font-medium">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions" class="hover:text-link transition-colors font-medium">Terms & Conditions</a></li>
          </ul>
        </div>

      </div>

    </div>

    <!-- Copyright & Disclaimer Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-mute font-mono">
      <span>© {currentYear} jsonformatterai.com. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy" class="hover:text-ink transition-colors">Privacy</a>
        <span>·</span>
        <a href="/terms-and-conditions" class="hover:text-ink transition-colors">Terms</a>
        <span>·</span>
        <a href="/contact-us" class="hover:text-ink transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
