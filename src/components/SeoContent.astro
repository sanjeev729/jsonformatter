---
// SeoContent.astro - Keyword-rich, high-performance SEO section for jsonformatterai.com
import FaqSection from './FaqSection.astro';
---

<section class="max-w-[1750px] w-full mx-auto px-3 sm:px-6 lg:px-8 py-10 sm:py-16 my-6 border-t border-hairline/60 bg-canvas/40 backdrop-blur-sm select-text transition-colors duration-200">
  <!-- Header Badge & Title -->
  <div class="max-w-4xl mx-auto text-center mb-10 sm:mb-14">
    <span class="inline-flex items-center gap-2 text-caption-mono text-link text-xs font-semibold uppercase tracking-wider bg-link-bg-soft/50 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full border border-link/30 mb-4">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      DEVELOPER KNOWLEDGE & SEO GUIDE
    </span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-ink tracking-tight mb-4">
