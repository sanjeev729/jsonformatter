      <pre class="leading-relaxed text-link-deep dark:text-cyan"><code>{"{"}
  <span class="text-ink dark:text-canvas">"status"</span>: <span class="text-violet">"success"</span>,
  <span class="text-ink dark:text-canvas">"code"</span>: <span class="text-warning-deep dark:text-warning">200</span>,
  <span class="text-ink dark:text-canvas">"payload"</span>: {"{"}
    <span class="text-ink dark:text-canvas">"user_id"</span>: <span class="text-violet">"usr_99812"</span>,
    <span class="text-ink dark:text-canvas">"roles"</span>: [<span class="text-violet">"admin"</span>, <span class="text-violet">"developer"</span>],
    <span class="text-ink dark:text-canvas">"verified"</span>: <span class="text-link">true</span>
  {"}"}
{"}"}</code></pre>
    </div>
  </div>

  <!-- Content Section 4: Privacy & FAQ Matrix -->
  <FaqSection />
</section>
