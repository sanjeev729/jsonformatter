  },
  {
    id: 'json-formatter-how-to-use',
    question: 'json formatter how to use',
    category: 'guides',
    answer: 'Copy your raw JSON code, paste it into the jsonformatterai.com input panel, and click "Format". If your JSON has errors like missing quotes or extra commas, use the AI Repair feature to fix them automatically.'
  },
  {
    id: 'how-to-use-json-formatter-extension',
