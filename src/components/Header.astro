---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Formatter', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms', href: '/terms-and-conditions' },
  { label: 'Contact Us', href: '/contact-us' },
];

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path) || (path === '/about-us' && currentPath === '/about') || (path === '/privacy-policy' && currentPath === '/privacy') || (path === '/terms-and-conditions' && currentPath === '/terms') || (path === '/contact-us' && currentPath === '/contact');
};
---

<header class="sticky top-0 z-50 w-full bg-canvas/80 backdrop-blur-md border-b border-hairline transition-colors duration-200">
  <div class="max-w-[1750px] mx-auto px-3 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2.5 group shrink-0">
      <div class="relative w-7 h-7 sm:w-8 sm:h-8 rounded-md bg-primary flex items-center justify-center overflow-hidden transition-transform duration-200 group-hover:scale-[1.03]">
        <div class="absolute inset-0 opacity-80 bg-gradient-to-tr from-cyan-deep via-violet to-highlight-pink scale-110 group-hover:rotate-12 transition-transform duration-500"></div>
        <span class="relative z-10 font-mono text-sm sm:text-base font-bold text-white leading-none">{}</span>
      </div>
      <div class="flex flex-col">
        <span class="font-sans font-semibold text-sm sm:text-lg text-ink tracking-tight leading-none">JSONFormatter<span class="text-link font-mono font-bold">.AI</span></span>
        <span class="hidden sm:block font-mono text-[9px] text-mute uppercase tracking-widest mt-0.5">jsonformatterai.com</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md text-xs lg:text-sm font-medium font-sans transition-colors ${
              active
                ? 'bg-canvas-soft-2 text-ink font-semibold border border-hairline'
                : 'text-body hover:text-ink hover:bg-canvas-soft/80'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Navigation Affordances & Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Privacy Status Indicator -->
      <div class="hidden xl:flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft-2 border border-hairline shadow-level-1 transition-all duration-200">
        <div class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </div>
        <span class="text-caption-mono text-body text-[11px] font-medium">Local Secure Sandbox</span>
      </div>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        class="w-8.5 h-8.5 sm:w-9 sm:h-9 flex items-center justify-center rounded-full border border-hairline bg-canvas text-ink shadow-level-2 hover:bg-canvas-soft-2 transition-all duration-200 cursor-pointer"
        aria-label="Toggle Theme"
      >
        <!-- Sun Icon (visible in Dark Mode) -->
        <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 sm:w-4.5 sm:h-4.5 transition-transform duration-300 hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <!-- Moon Icon (visible in Light Mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 sm:w-4.5 sm:h-4.5 transition-transform duration-300 hover:-rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-8.5 h-8.5 flex items-center justify-center rounded-lg border border-hairline bg-canvas text-ink hover:bg-canvas-soft-2 transition-all duration-200 cursor-pointer"
        aria-label="Toggle Navigation Menu"
      >
        <svg id="mobile-menu-open-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mobile-menu-close-icon" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-hairline bg-canvas/95 backdrop-blur-lg px-4 py-3 space-y-1">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded-lg text-sm font-medium font-sans transition-colors ${
            active
              ? 'bg-canvas-soft-2 text-ink font-semibold border border-hairline'
              : 'text-body hover:text-ink hover:bg-canvas-soft'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-2 border-t border-hairline/60 flex items-center justify-between text-xs text-mute font-mono">
      <span>Privacy Sandbox</span>
      <span class="text-green-500 font-semibold">● 100% Offline</span>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Script
  const themeToggleBtn = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  const updateToggleIcons = () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    }
  };

  updateToggleIcons();

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateToggleIcons();
  });

  // Mobile Menu Script
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('mobile-menu-open-icon');
  const closeIcon = document.getElementById('mobile-menu-close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });
</script>
