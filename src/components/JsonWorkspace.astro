    let html = '';

    processedItems.forEach(item => {
      if (item.type === 'normal') {
        const lineNumA = String(item.lineA).padStart(4, ' ');
        const lineNumB = String(item.lineB).padStart(4, ' ');
        html += `
          <div class="grid grid-cols-2 divide-x divide-hairline border-b border-hairline last:border-0 hover:bg-canvas-soft-2 transition-colors select-text">
