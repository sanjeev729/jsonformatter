  // Main comparison triggers
  const runComparison = () => {
    const rawA = diffInputA.value.trim();
    const rawB = diffInputB.value.trim();

    if (!rawA && !rawB) {
      alert("Please enter JSON data in Box A and Box B first.");
      return;
    }

    diffOutputPanel?.classList.remove('hidden');

    let objA: any = null;
    let objB: any = null;
    let validJson = true;

    try {
      objA = JSON.parse(rawA);
    } catch (e) {
      validJson = false;
    }

    try {
      objB = JSON.parse(rawB);
    } catch (e) {
      validJson = false;
    }

    // Process Ignored keys if valid
    const ignoreVal = diffIgnoreKeysInput.value.trim();
    const ignoreKeys = ignoreVal ? ignoreVal.split(',').map(k => k.trim()).filter(Boolean) : [];

    let aPretty = rawA;
    let bPretty = rawB;

    if (validJson) {
      const cleanA = cloneAndFilter(objA, ignoreKeys);
      const cleanB = cloneAndFilter(objB, ignoreKeys);
      diffTreeCache = diffStructures(cleanA, cleanB);

      aPretty = JSON.stringify(cleanA, null, 2);
      bPretty = JSON.stringify(cleanB, null, 2);
    } else {
      diffTreeCache = null;
      // If ignoreKeys are provided, we attempt simple regex replacement for line compares too
      if (ignoreKeys.length > 0) {
        const filterLines = (text: string) => {
          return text.split('\n').filter(line => {
            return !ignoreKeys.some(key => line.includes(`"${key}"`));
          }).join('\n');
        };
        aPretty = filterLines(rawA);
        bPretty = filterLines(rawB);
      }
    }

    // Compute line differences
    const diffLines = calculateLcsDiff(aPretty, bPretty);

    // Group adjacent removals/additions into modifications
    let i = 0;
    const processed = [];
    let addCount = 0;
    let delCount = 0;
    let modCount = 0;

    while (i < diffLines.length) {
      const cur = diffLines[i];
      const next = diffLines[i + 1];

      if (cur.type === 'removed' && next && next.type === 'added') {
        processed.push({
          type: 'modified',
          valA: cur.val,
          valB: next.val,
          lineA: cur.lineA,
          lineB: next.lineB
        });
        modCount++;
        i += 2;
      } else {
        processed.push(cur);
        if (cur.type === 'added') addCount++;
        else if (cur.type === 'removed') delCount++;
        i++;
      }
    }

    // Update Stats Badges
    if (diffStatAdd) diffStatAdd.innerHTML = `<span class="font-bold">+</span> ${addCount} Added`;
    if (diffStatDel) diffStatDel.innerHTML = `<span class="font-bold">-</span> ${delCount} Deleted`;
    if (diffStatMod) diffStatMod.innerHTML = `<span class="font-bold">~</span> ${modCount} Modified`;

    // Render Split and Unified HTML
    renderSplitHtml(processed);
    renderUnifiedHtml(processed);

    if (diffActiveView === 'tree') {
      if (!validJson) {
        diffOutputTree!.innerHTML = `
          <div class="p-8 text-center text-xs text-mute font-sans">
            <svg class="w-8 h-8 text-warning mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="font-semibold text-ink">Tree Diff Unavailable</p>
            <p class="mt-1">Tree comparison requires both inputs to be valid JSON documents.</p>
          </div>
        `;
      } else {
        renderTreeDiffPanel();
      }
    }

    // Update navigator mappings
    updateNavigatorTargets();

    // Auto-scroll output panel into view
    diffOutputPanel.scrollIntoView({ behavior: 'smooth' });
  };

  btnCompare?.addEventListener('click', runComparison);

  // Render Split view
  const renderSplitHtml = (processedItems: any[]) => {
