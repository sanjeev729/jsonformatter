  const outputStats = document.getElementById('output-stats');
  const outputPane = document.getElementById('output-pane');
  const outputFormatted = document.getElementById('output-formatted');
  const outputTree = document.getElementById('output-tree');
  const outputMinified = document.getElementById('output-minified') as HTMLTextAreaElement;
  
  const btnFormat = document.getElementById('btn-format');
  const btnMinify = document.getElementById('btn-minify');
  const btnClear = document.getElementById('btn-clear');
  const btnCopy = document.getElementById('btn-copy');
  const btnDownload = document.getElementById('btn-download');
  const fileUploader = document.getElementById('file-uploader') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone');

  const sampleButtons = document.querySelectorAll('.sample-load-btn');
  const viewButtons = document.querySelectorAll('.output-view-btn');
  const treeSearchBar = document.getElementById('tree-search-bar');
  const treeSearch = document.getElementById('tree-search') as HTMLInputElement;
  const btnTreeExpand = document.getElementById('btn-tree-expand');
  const btnTreeCollapse = document.getElementById('btn-tree-collapse');

  // --- Diff Elements ---
  const diffInputA = document.getElementById('diff-input-a') as HTMLTextAreaElement;
  const diffInputB = document.getElementById('diff-input-b') as HTMLTextAreaElement;
  const diffLineNumbersA = document.getElementById('diff-line-numbers-a');
  const diffLineNumbersB = document.getElementById('diff-line-numbers-b');
  const btnCompare = document.getElementById('btn-compare');
  const diffOutputPanel = document.getElementById('diff-output-panel');
  
  const btnDiffSample = document.getElementById('btn-diff-sample');
  const btnDiffSwap = document.getElementById('btn-diff-swap');
  const btnDiffFormat = document.getElementById('btn-diff-format');
  const btnDiffClear = document.getElementById('btn-diff-clear');
  const diffIgnoreKeysInput = document.getElementById('diff-ignore-keys') as HTMLInputElement;

  const btnDiffViewSplit = document.getElementById('btn-diff-view-split');
  const btnDiffViewUnified = document.getElementById('btn-diff-view-unified');
  const btnDiffViewTree = document.getElementById('btn-diff-view-tree');
  
  const diffOutputSplit = document.getElementById('diff-output-split');
  const diffOutputUnified = document.getElementById('diff-output-unified');
  const diffOutputTree = document.getElementById('diff-output-tree');

  const diffStatAdd = document.getElementById('diff-stat-add');
  const diffStatDel = document.getElementById('diff-stat-del');
  const diffStatMod = document.getElementById('diff-stat-mod');

  const btnDiffPrev = document.getElementById('btn-diff-prev') as HTMLButtonElement;
  const btnDiffNext = document.getElementById('btn-diff-next') as HTMLButtonElement;
  const diffNavStats = document.getElementById('diff-nav-stats');
  const chkDiffShowChanges = document.getElementById('chk-diff-show-changes') as HTMLInputElement;
  const lblDiffShowChanges = document.getElementById('lbl-diff-show-changes');

  const fileUploaderA = document.getElementById('file-uploader-a') as HTMLInputElement;
  const fileUploaderB = document.getElementById('file-uploader-b') as HTMLInputElement;
  const dropZoneA = document.getElementById('drop-zone-a');
  const dropZoneB = document.getElementById('drop-zone-b');

  // --- Converter Elements ---
  const converterSelect = document.getElementById('converter-select') as HTMLSelectElement;
  const converterInput = document.getElementById('converter-input') as HTMLTextAreaElement;
  const converterOutput = document.getElementById('converter-output') as HTMLTextAreaElement;
  const btnConvert = document.getElementById('btn-convert');
  const converterInputLabel = document.getElementById('converter-input-label');
  const converterOutputLabel = document.getElementById('converter-output-label');
  const btnConverterSwap = document.getElementById('btn-converter-swap');
  const btnConverterClear = document.getElementById('btn-converter-clear');
  const btnConverterCopy = document.getElementById('btn-converter-copy');
  const btnConverterDownload = document.getElementById('btn-converter-download');

  // --- Encoder/Decoder Elements ---
  const encoderSelect = document.getElementById('encoder-select') as HTMLSelectElement;
  const encoderInput = document.getElementById('encoder-input') as HTMLTextAreaElement;
  const encoderOutput = document.getElementById('encoder-output') as HTMLTextAreaElement;
  const btnEncode = document.getElementById('btn-encode');
  const btnEncoderClear = document.getElementById('btn-encoder-clear');
  const btnEncoderCopy = document.getElementById('btn-encoder-copy');

  // --- History Elements ---
  const historyList = document.getElementById('history-list');
  const btnClearHistory = document.getElementById('btn-clear-history');

  // State
  let currentActiveView = 'formatted'; // formatted, tree, minified
  let parsedJsonCache: any = null;
  let syntaxErrorLine = -1;

  // Samples mapping
  const samples = {
    simple: {
      name: "Jane Doe Profile",
      active: true,
      age: 28,
      skills: ["JavaScript", "TypeScript", "Astro", "Tailwind CSS"],
      address: {
        city: "San Francisco",
        state: "CA"
      }
    },
    nested: [
      {
        id: 1,
        title: "Vercel Hoodie",
        price: 65.0,
        tags: ["apparel", "gear"],
        inStock: true
      },
      {
        id: 2,
        title: "Geist Keycap Set",
        price: 120.5,
        tags: ["electronics", "keyboard"],
        inStock: false
      }
    ],
    config: {
      server: {
        host: "127.0.0.1",
        port: 8080,
        ssl: false
      },
      database: {
        client: "postgresql",
        connection: {
          database: "production_db",
          user: "postgres",
          password: "super-secure-password-123"
        },
        pool: {
          min: 2,
          max: 10
        }
      },
      features: {
        websockets: true,
        cache: "redis"
      }
    }
  };

  // --- 1. Tab Navigation Routing ---
  const initializeTabs = () => {
    // Set initial position of tab indicator line
    const activeTab = document.querySelector('.tab-btn.text-link') as HTMLElement;
    if (activeTab && tabIndicator) {
      tabIndicator.style.width = `${activeTab.offsetWidth}px`;
      tabIndicator.style.left = `${activeTab.offsetLeft}px`;
    }
  };

  tabButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const targetPanelId = btn.getAttribute('data-target');
      
      // Update styling
      tabButtons.forEach(b => {
        b.classList.remove('text-link', 'border-link');
        b.classList.add('text-body', 'border-transparent');
      });
      btn.classList.add('text-link', 'border-link');
      btn.classList.remove('text-body', 'border-transparent');

      // Sync active sliding bar
      if (tabIndicator) {
        tabIndicator.style.width = `${(btn as HTMLElement).offsetWidth}px`;
        tabIndicator.style.left = `${(btn as HTMLElement).offsetLeft}px`;
      }

      // Hide all panels, show target
      panels.forEach(panel => {
        if (panel.id === targetPanelId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  window.addEventListener('resize', initializeTabs);
  setTimeout(initializeTabs, 100);

  // --- 2. Code Editor Sync & Line Numbers ---
  const updateLineCounter = () => {
    if (!jsonInput || !lineNumbers) return;
    const value = jsonInput.value;
    const lines = value.split('\n');
    const lineCount = lines.length;

    let lineNumbersHtml = '';
    for (let i = 1; i <= lineCount; i++) {
      lineNumbersHtml += `<div class="h-6 pr-1">${i}</div>`;
    }
    lineNumbers.innerHTML = lineNumbersHtml;
    
    // Update chars count
    if (statsLabel) {
      statsLabel.textContent = `Lines: ${lineCount} · Chars: ${value.length}`;
    }
  };

  jsonInput?.addEventListener('input', updateLineCounter);
  jsonInput?.addEventListener('scroll', () => {
    if (lineNumbers && jsonInput) {
      lineNumbers.scrollTop = jsonInput.scrollTop;
    }
  });

  // --- 3. Format/Minify Core Logic ---
  const formatJSON = (logHistory = true) => {
    const rawVal = jsonInput.value.trim();
    if (!rawVal) {
      clearOutput();
      return;
    }

    try {
      // Clean up error state
      hideError();

      // Parse JSON
      const parsed = JSON.parse(rawVal);
      parsedJsonCache = parsed;

      // Formatting parameters
      const indentVal = indentSelect.value;
      const spaceVal = indentVal === 'tab' ? '\t' : parseInt(indentVal, 10);
      
      // Generate formats
      const prettyText = JSON.stringify(parsed, null, spaceVal);
      const minifiedText = JSON.stringify(parsed);

      // Render output text boxes
      if (outputFormatted) outputFormatted.textContent = prettyText;
      if (outputMinified) outputMinified.value = minifiedText;

      // Update statistics
      const byteSize = new Blob([prettyText]).size;
      const formattedSize = byteSize > 1024 ? `${(byteSize / 1024).toFixed(2)} KB` : `${byteSize} B`;
      if (outputStats) {
        outputStats.textContent = `Size: ${formattedSize}`;
      }

      // Render tree hierarchy
      renderTree();

      // Log into history
      if (logHistory) {
        saveHistoryItem(rawVal);
      }
    } catch (err: any) {
      // Find line number and column number from error
      parseAndShowError(rawVal, err);
      parsedJsonCache = null;
    }
  };

  const minifyJSON = () => {
    const rawVal = jsonInput.value.trim();
    if (!rawVal) return;

    try {
      hideError();
      const parsed = JSON.parse(rawVal);
      const minifiedText = JSON.stringify(parsed);
      
      if (outputMinified) outputMinified.value = minifiedText;
      if (outputFormatted) outputFormatted.textContent = minifiedText;
      
      // Update subview to formatted or minified
      switchSubView('minified');
      
      // Statistics
      const byteSize = new Blob([minifiedText]).size;
      const formattedSize = byteSize > 1024 ? `${(byteSize / 1024).toFixed(2)} KB` : `${byteSize} B`;
      if (outputStats) outputStats.textContent = `Size: ${formattedSize}`;

      saveHistoryItem(rawVal);
    } catch (err: any) {
      parseAndShowError(rawVal, err);
    }
  };

  const clearOutput = () => {
    if (outputFormatted) outputFormatted.textContent = '';
    if (outputTree) outputTree.innerHTML = '';
    if (outputMinified) outputMinified.value = '';
    if (outputStats) outputStats.textContent = 'Size: 0 B';
    parsedJsonCache = null;
  };

  const hideError = () => {
    errorBanner?.classList.add('hidden');
    syntaxErrorLine = -1;
    btnFixError?.classList.add('hidden');
  };

  const parseAndShowError = (input: string, err: Error) => {
    errorBanner?.classList.remove('hidden');
    errorTitle!.textContent = "Invalid JSON structure";
    
    let message = err.message;
    let line = -1;
    let col = -1;

    // Standard V8 Error Parsing: "Unexpected token } in JSON at position 156"
    // Or Safari error: "JSON.parse: unexpected character at line 4 column 12 of the JSON data"
    const posMatch = message.match(/position (\d+)/i);
    const lineColMatch = message.match(/line (\d+) column (\d+)/i);

    if (lineColMatch) {
      line = parseInt(lineColMatch[1], 10);
      col = parseInt(lineColMatch[2], 10);
    } else if (posMatch) {
      const pos = parseInt(posMatch[1], 10);
      const beforePos = input.slice(0, pos);
      const lines = beforePos.split('\n');
      line = lines.length;
      col = lines[lines.length - 1].length + 1;
    }

    if (line > 0) {
      errorDesc!.textContent = `${message} (at Line ${line}, Column ${col})`;
      syntaxErrorLine = line;
      btnFixError?.classList.remove('hidden');
    } else {
      errorDesc!.textContent = message;
      btnFixError?.classList.add('hidden');
    }
  };

