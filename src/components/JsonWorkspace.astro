  // --- 3. Format/Minify Core Logic ---
  const formatJSON = (logHistory = true) => {
    const rawVal = jsonInput.value.trim();
    if (!rawVal) {
      clearOutput();
      return;
    }

    try {
      // Clean up error state
      hideError();

      // Parse JSON
      const parsed = JSON.parse(rawVal);
      parsedJsonCache = parsed;

      // Formatting parameters
      const indentVal = indentSelect.value;
      const spaceVal = indentVal === 'tab' ? '\t' : parseInt(indentVal, 10);
      
      // Generate formats
      const prettyText = JSON.stringify(parsed, null, spaceVal);
      const minifiedText = JSON.stringify(parsed);

      // Render output text boxes
      if (outputFormatted) outputFormatted.textContent = prettyText;
      if (outputMinified) outputMinified.value = minifiedText;

      // Update statistics
      const byteSize = new Blob([prettyText]).size;
      const formattedSize = byteSize > 1024 ? `${(byteSize / 1024).toFixed(2)} KB` : `${byteSize} B`;
      if (outputStats) {
        outputStats.textContent = `Size: ${formattedSize}`;
      }

      // Render tree hierarchy
      renderTree();

      // Log into history
      if (logHistory) {
        saveHistoryItem(rawVal);
      }
    } catch (err: any) {
      // Find line number and column number from error
      parseAndShowError(rawVal, err);
      parsedJsonCache = null;
    }
  };

