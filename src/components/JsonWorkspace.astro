---
---
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex-1 flex flex-col gap-6">
  <!-- Tabs Navigation -->
  <div class="relative flex border-b border-hairline transition-colors duration-200 overflow-x-auto scrollbar-none">
    <!-- Mesh Gradient accent line under tabs -->
    <div class="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-cyan to-violet w-0 transition-all duration-300" id="tab-indicator"></div>
    
    <nav class="flex gap-1 sm:gap-6 -mb-[1px] flex-nowrap mx-0.5 sm:mx-0">
      <button 
        data-target="panel-formatter" 
        class="tab-btn pb-3 sm:pb-3.5 px-0.5 sm:px-1 font-sans font-medium text-[11px] sm:text-sm text-link border-b-2 border-link cursor-pointer transition-colors whitespace-nowrap"
      >
        <span class="sm:hidden">Formatter</span>
        <span class="hidden sm:inline">Formatter & Validator</span>
      </button>
      <button 
        data-target="panel-diff" 
        class="tab-btn pb-3 sm:pb-3.5 px-0.5 sm:px-1 font-sans font-medium text-[11px] sm:text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors whitespace-nowrap"
      >
        Diff Compare
      </button>
      <button 
        data-target="panel-converters" 
        class="tab-btn pb-3 sm:pb-3.5 px-0.5 sm:px-1 font-sans font-medium text-[11px] sm:text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors whitespace-nowrap"
      >
        Converters
      </button>
      <button 
        data-target="panel-encoder" 
        class="tab-btn pb-3 sm:pb-3.5 px-0.5 sm:px-1 font-sans font-medium text-[11px] sm:text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors whitespace-nowrap"
      >
        <span class="sm:hidden">Base64</span>
        <span class="hidden sm:inline">Base64 & URL</span>
      </button>
    </nav>
  </div>

  <!-- Workspace Cards Area -->
  <div class="flex-1 flex flex-col min-h-[400px] sm:min-h-[600px] lg:flex-row gap-4 sm:gap-6">
    <!-- Main Workspace Console -->
    <div class="flex-1 bg-canvas border border-hairline shadow-level-3 rounded-xl overflow-hidden flex flex-col transition-all duration-200">
      
      <!-- Panel 1: Formatter & Linter -->
      <div id="panel-formatter" class="workspace-panel flex-1 flex flex-col">
        <!-- Editor Header toolbar -->
        <div class="border-b border-hairline bg-canvas-soft-2 px-3 sm:px-4 py-2 flex sm:py-2.5 flex-wrap items-center justify-between gap-2 sm:gap-3 text-xs select-none">
          <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
            <!-- Upload -->
            <label class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body font-medium shadow-level-2 transition-all cursor-pointer flex items-center gap-1 sm:gap-1.5">
              <input type="file" id="file-uploader" class="hidden" accept=".json,.txt" />
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span class="hidden sm:inline">Upload JSON</span>
              <span class="sm:hidden">Upload</span>
            </label>
            <!-- Sample JSON -->
            <div class="relative" id="sample-dropdown-wrapper">
              <button id="btn-sample-toggle" type="button" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body font-medium shadow-level-2 transition-all cursor-pointer flex items-center gap-1">
                <span class="hidden sm:inline">Load Sample</span>
                <span class="sm:hidden">Sample</span>
                <svg class="w-3 h-3 text-mute transition-transform duration-200" id="sample-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="sample-dropdown-menu" class="absolute sm:left-0 right-0 top-full mt-1 hidden w-40 rounded-lg border border-hairline bg-canvas shadow-level-5 py-1 z-30">
                <button type="button" data-sample="simple" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Simple Object</button>
                <button type="button" data-sample="nested" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Nested Array</button>
                <button type="button" data-sample="config" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Config File</button>
              </div>
            </div>
            <!-- Clear -->
            <button id="btn-clear" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-error font-medium shadow-level-2 transition-all cursor-pointer">
              Clear
            </button>
          </div>

          <div class="flex items-center gap-2 sm:gap-3">
            <span class="hidden sm:inline text-mute font-medium">Indent:</span>
            <select id="indent-select" class="px-1.5 sm:px-2 py-1 rounded border border-hairline bg-canvas text-body focus:outline-none cursor-pointer">
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4" selected>4</option>
              <option value="tab">Tab</option>
            </select>
          </div>
        </div>

        <!-- Editor Split Screen -->
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
          <!-- Left: Input Area -->
          <div class="flex flex-col relative h-[280px] sm:h-[450px] lg:h-auto min-h-[200px] sm:min-h-[350px]">
            <!-- File Drag/Drop Overlay -->
            <div id="drop-zone" class="absolute inset-0 bg-canvas/90 border-2 border-dashed border-link z-20 hidden items-center justify-center flex-col gap-3 transition-opacity duration-200">
              <div class="w-12 h-12 rounded-full bg-link-bg-soft flex items-center justify-center text-link">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <div class="text-center">
                <p class="font-sans font-semibold text-sm text-ink">Drop your JSON file here</p>
                <p class="text-xs text-mute mt-0.5">Supports .json or plain text format</p>
              </div>
            </div>

            <!-- Custom Editor container with line numbers -->
            <div class="flex-1 flex overflow-hidden bg-canvas relative">
              <!-- Line Numbers Column -->
              <div id="editor-line-numbers" class="w-10 py-4 font-mono text-[13px] text-mute select-none border-r border-hairline bg-canvas-soft text-right pr-2 leading-6 overflow-hidden">
                <div>1</div>
              </div>
              <!-- Text Area -->
              <textarea 
                id="json-input" 
                class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-transparent whitespace-pre overflow-x-auto"
                placeholder='Paste or drag raw JSON text here... (e.g. {"status":"secure"})'
                spellcheck="false"
                wrap="off"
              ></textarea>
            </div>
            
            <!-- Error Banner -->
            <div id="error-banner" class="hidden border-t border-error-soft bg-error-soft/10 text-error px-4 py-3 text-xs flex items-start gap-2.5 transition-all">
              <svg class="w-4 h-4 text-error shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p class="font-semibold" id="error-title">Syntax Error</p>
                <p class="text-[11px] mt-0.5" id="error-desc"></p>
              </div>
              <button id="btn-fix-error" class="hidden shrink-0 px-2 py-1 rounded bg-error text-[10px] text-white font-medium hover:bg-error-deep cursor-pointer transition-colors">
                Go to Line
              </button>
            </div>

            <!-- Bottom Left Status bar -->
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex items-center justify-between text-[11px] text-mute font-mono select-none">
              <span id="editor-stats">Lines: 1 · Chars: 0</span>
              <span class="text-caption-mono text-mute">JSON Input</span>
            </div>
          </div>

          <!-- Right: Output Area -->
          <div class="flex flex-col relative h-[280px] sm:h-[450px] lg:h-auto min-h-[200px] sm:min-h-[350px]">
            
            <!-- Output Sub Tabs / Controls -->
            <div class="border-b border-hairline bg-canvas-soft px-3 sm:px-4 py-2 flex items-center justify-between text-xs select-none">
              <!-- Sub Panel selector -->
              <div class="flex border border-hairline rounded-md bg-canvas overflow-hidden shadow-level-1">
                <button data-view="formatted" class="output-view-btn px-2 sm:px-3 py-1.5 font-medium text-ink bg-canvas-soft-2 transition-colors cursor-pointer border-r border-hairline text-[11px] sm:text-xs">Formatted</button>
                <button data-view="tree" class="output-view-btn px-2 sm:px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer border-r border-hairline text-[11px] sm:text-xs">Tree View</button>
                <button data-view="minified" class="output-view-btn px-2 sm:px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer text-[11px] sm:text-xs">Minified</button>
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-1.5 sm:gap-2">
                <button id="btn-copy" class="p-1.5 rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer" title="Copy output">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-5 4h6m-6 4h6m-2 4h4" />
                  </svg>
                </button>
                <button id="btn-download" class="p-1.5 rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer" title="Download formatted file">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Output Search toolbar (conditional - only for Tree view) -->
            <div id="tree-search-bar" class="hidden border-b border-hairline bg-canvas px-3 sm:px-4 py-2 flex items-center justify-between gap-2 sm:gap-3 select-none">
              <div class="relative flex-1">
                <input 
                  type="text" 
                  id="tree-search" 
                  class="w-full pl-7 pr-3 py-1 text-xs rounded border border-hairline bg-canvas-soft focus:outline-none placeholder:text-mute focus:bg-canvas"
                  placeholder="Filter keys or values..."
                />
                <svg class="w-3.5 h-3.5 text-mute absolute left-2 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <div class="flex items-center gap-1.5">
                <button id="btn-tree-expand" class="px-2 py-1 rounded border border-hairline text-[10px] font-medium bg-canvas hover:bg-canvas-soft-2 cursor-pointer">Expand All</button>
                <button id="btn-tree-collapse" class="px-2 py-1 rounded border border-hairline text-[10px] font-medium bg-canvas hover:bg-canvas-soft-2 cursor-pointer">Collapse All</button>
              </div>
            </div>

            <!-- Display subviews -->
            <div class="flex-1 overflow-auto bg-canvas relative p-4" id="output-pane">
              <!-- Formatted Raw text view -->
              <pre id="output-formatted" class="font-mono text-[13px] text-ink leading-6 select-all break-all whitespace-pre-wrap"></pre>
              
              <!-- Tree view container -->
              <div id="output-tree" class="hidden font-mono text-[13px] text-ink leading-6 select-none select-tree-container"></div>
              
              <!-- Minified text view -->
              <textarea id="output-minified" class="hidden w-full h-full font-mono text-[13px] text-ink leading-6 bg-transparent border-none focus:outline-none select-all resize-none" readonly></textarea>
            </div>

            <!-- Bottom Right Status bar -->
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex items-center justify-between text-[11px] text-mute font-mono select-none">
              <span id="output-stats">Size: 0 B</span>
              <span class="text-caption-mono text-mute">JSON Output</span>
            </div>
          </div>
        </div>

        <!-- Format button at center bottom -->
        <div class="border-t border-hairline p-3 sm:p-4 bg-canvas flex items-center justify-center gap-2 sm:gap-4">
          <button id="btn-format" class="flex-1 sm:flex-none px-4 sm:px-6 py-2.5 rounded-full bg-primary hover:opacity-90 text-on-primary font-sans font-semibold text-sm shadow-level-4 transition-all duration-200 cursor-pointer select-none">
            Beautify JSON
          </button>
          <button id="btn-minify" class="flex-1 sm:flex-none px-4 sm:px-5 py-2.5 rounded-full bg-canvas border border-hairline hover:bg-canvas-soft-2 text-ink font-sans font-medium text-sm shadow-level-2 transition-all duration-200 cursor-pointer select-none">
            Minify JSON
          </button>
        </div>
      </div>

      <!-- Panel 2: Diff Compare -->
      <div id="panel-diff" class="workspace-panel flex-1 flex flex-col hidden">
        <!-- Editor Header toolbar -->
        <div class="border-b border-hairline bg-canvas-soft-2 px-3 sm:px-4 py-2 sm:py-2.5 flex flex-wrap items-center justify-between gap-2 sm:gap-3 text-xs select-none">
          <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
            <!-- Load Sample Diff -->
            <button id="btn-diff-sample" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body font-medium shadow-level-2 transition-all cursor-pointer">
              <span class="hidden sm:inline">Load Sample Diff</span>
              <span class="sm:hidden">Sample</span>
            </button>
            <!-- Swap Inputs -->
            <button id="btn-diff-swap" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              <span class="hidden sm:inline">Swap A ⇄ B</span>
              <span class="sm:hidden">Swap</span>
            </button>
            <!-- Format Inputs -->
            <button id="btn-diff-format" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer" title="Format both inputs">
              <span class="hidden sm:inline">Format inputs</span>
              <span class="sm:hidden">Format</span>
            </button>
            <!-- Clear Both -->
            <button id="btn-diff-clear" class="px-2 sm:px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-error font-medium shadow-level-2 transition-all cursor-pointer">
              <span class="hidden sm:inline">Clear Both</span>
              <span class="sm:hidden">Clear</span>
            </button>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-mute font-medium whitespace-nowrap">Ignore keys:</span>
            <input 
              type="text" 
              id="diff-ignore-keys" 
              class="px-2.5 py-1.5 rounded-md border border-hairline bg-canvas text-ink focus:outline-none placeholder:text-mute focus:bg-canvas w-full sm:w-44" 
              placeholder="e.g. updated_at, id, uuid"
            />
          </div>
        </div>

        <!-- Inputs Split Screen -->
        <div class="flex-grow grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline min-h-[250px] sm:min-h-[350px]">
          <!-- JSON A Input -->
          <div class="flex flex-col relative h-[180px] sm:h-[220px] lg:h-auto">
            <!-- File Drag/Drop Overlay A -->
            <div id="drop-zone-a" class="absolute inset-0 bg-canvas/90 border-2 border-dashed border-link z-20 hidden items-center justify-center flex-col gap-3 transition-opacity duration-200">
              <div class="w-10 h-10 rounded-full bg-link-bg-soft flex items-center justify-center text-link">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <p class="font-sans font-semibold text-xs text-ink">Drop Original JSON A here</p>
            </div>
            
            <div class="flex-grow flex overflow-hidden bg-canvas relative">
              <div id="diff-line-numbers-a" class="w-9 py-4 font-mono text-[13px] text-mute select-none border-r border-hairline bg-canvas-soft text-right pr-2 leading-6 overflow-hidden">
                <div>1</div>
              </div>
              <textarea 
                id="diff-input-a" 
                class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-transparent whitespace-pre overflow-x-auto"
                placeholder='Paste Original JSON A here...'
                spellcheck="false"
                wrap="off"
              ></textarea>
            </div>
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex justify-between items-center text-[10px] text-mute font-mono select-none">
              <span>Original JSON A</span>
              <label class="hover:text-ink cursor-pointer flex items-center gap-1">
                <input type="file" id="file-uploader-a" class="hidden" accept=".json,.txt" />
                <span>Upload file</span>
              </label>
            </div>
          </div>
          <!-- JSON B Input -->
          <div class="flex flex-col relative h-[180px] sm:h-[220px] lg:h-auto">
            <!-- File Drag/Drop Overlay B -->
            <div id="drop-zone-b" class="absolute inset-0 bg-canvas/90 border-2 border-dashed border-link z-20 hidden items-center justify-center flex-col gap-3 transition-opacity duration-200">
              <div class="w-10 h-10 rounded-full bg-link-bg-soft flex items-center justify-center text-link">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <p class="font-sans font-semibold text-xs text-ink">Drop Modified JSON B here</p>
            </div>
            
            <div class="flex-grow flex overflow-hidden bg-canvas relative">
              <div id="diff-line-numbers-b" class="w-9 py-4 font-mono text-[13px] text-mute select-none border-r border-hairline bg-canvas-soft text-right pr-2 leading-6 overflow-hidden">
                <div>1</div>
              </div>
              <textarea 
                id="diff-input-b" 
                class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-transparent whitespace-pre overflow-x-auto"
                placeholder='Paste Modified JSON B here...'
                spellcheck="false"
                wrap="off"
              ></textarea>
            </div>
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex justify-between items-center text-[10px] text-mute font-mono select-none">
              <span>Modified JSON B</span>
              <label class="hover:text-ink cursor-pointer flex items-center gap-1">
                <input type="file" id="file-uploader-b" class="hidden" accept=".json,.txt" />
                <span>Upload file</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Run Compare action bar -->
        <div class="border-t border-hairline p-3 sm:p-4 bg-canvas flex items-center justify-center">
          <button id="btn-compare" class="w-full sm:w-auto px-4 sm:px-6 py-2.5 rounded-full bg-primary hover:opacity-90 text-on-primary font-sans font-semibold text-sm shadow-level-4 transition-all duration-200 cursor-pointer select-none">
            Compare JSON payloads
          </button>
        </div>

        <!-- Diff output display -->
        <div id="diff-output-panel" class="hidden border-t border-hairline bg-canvas-soft flex flex-col flex-1 min-h-[300px] sm:min-h-[400px]">
          <!-- Results Sub Toolbar -->
          <div class="border-b border-hairline bg-canvas-soft-2 px-3 sm:px-4 py-2 sm:py-3 flex flex-wrap items-center justify-between gap-2 sm:gap-3 text-xs select-none">
            <!-- View Tabs selector -->
            <div class="flex border border-hairline rounded-md bg-canvas overflow-hidden shadow-level-1 shrink-0">
              <button id="btn-diff-view-split" class="diff-view-btn px-2 sm:px-3 py-1.5 font-medium text-ink bg-canvas-soft-2 transition-colors cursor-pointer border-r border-hairline whitespace-nowrap">Split</button>
              <button id="btn-diff-view-unified" class="diff-view-btn px-2 sm:px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer border-r border-hairline whitespace-nowrap">Unified</button>
              <button id="btn-diff-view-tree" class="diff-view-btn px-2 sm:px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer whitespace-nowrap">Tree Diff</button>
            </div>

            <!-- Stats badges -->
            <div class="flex items-center gap-2 select-none flex-wrap font-sans text-[11px] font-medium">
              <span class="px-2 py-0.5 rounded bg-green-500/10 text-green-700 dark:text-green-400 border border-green-500/20 shadow-level-1 flex items-center gap-1" id="diff-stat-add">
                <span class="font-bold">+</span> 0 Added
              </span>
              <span class="px-2 py-0.5 rounded bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20 shadow-level-1 flex items-center gap-1" id="diff-stat-del">
                <span class="font-bold">-</span> 0 Deleted
              </span>
              <span class="px-2 py-0.5 rounded bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border border-yellow-500/20 shadow-level-1 flex items-center gap-1" id="diff-stat-mod">
                <span class="font-bold">~</span> 0 Modified
              </span>
            </div>

            <!-- Navigation Controls -->
            <div class="flex items-center gap-2 flex-wrap">
              <!-- Tree only: show only changes -->
              <label id="lbl-diff-show-changes" class="hidden items-center gap-1.5 text-xs text-body hover:text-ink cursor-pointer mr-2">
