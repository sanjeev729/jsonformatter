    for (let i = 0; i < syntaxErrorLine - 1; i++) {
      offset += lines[i].length + 1;
    }
    
    jsonInput.focus();
    jsonInput.setSelectionRange(offset, offset + (lines[syntaxErrorLine - 1] || '').length);
    
    // Approximate scroll calculation
    const lineHeightPx = 24; // text-[13px] leading-6 is roughly 24px
    jsonInput.scrollTop = (syntaxErrorLine - 1) * lineHeightPx;
  });

