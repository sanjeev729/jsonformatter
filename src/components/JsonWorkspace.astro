  // --- 9. LCS Diff Tool Engine ---
  const calculateLcsDiff = (text1: string, text2: string) => {
    const a = text1.split('\n');
    const b = text2.split('\n');
    const n = a.length;
    const m = b.length;
    
    // DP array size optimization: use 2D array since lengths are reasonable
    const dp = Array(n + 1).fill(0).map(() => Array(m + 1).fill(0));
    
    for (let i = 1; i <= n; i++) {
      for (let j = 1; j <= m; j++) {
        if (a[i - 1] === b[j - 1]) {
          dp[i][j] = dp[i - 1][j - 1] + 1;
        } else {
          dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
        }
      }
    }
    
    let i = n, j = m;
    const diff = [];
    
    while (i > 0 || j > 0) {
      if (i > 0 && j > 0 && a[i - 1] === b[j - 1]) {
        diff.push({ type: 'normal', val: a[i - 1], lineA: i, lineB: j });
        i--;
        j--;
      } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
        diff.push({ type: 'added', val: b[j - 1], lineA: null, lineB: j });
        j--;
      } else if (i > 0 && (j === 0 || dp[i][j - 1] < dp[i - 1][j])) {
        diff.push({ type: 'removed', val: a[i - 1], lineA: i, lineB: null });
        i--;
      }
    }
    
    return diff.reverse();
  };

  btnCompare?.addEventListener('click', () => {
