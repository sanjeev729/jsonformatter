  // CSV Conversion Helpers
  const convertJsonToCsv = (obj: any): string => {
    const arr = Array.isArray(obj) ? obj : [obj];
    if (arr.length === 0) return '';
    
    // Extract headers (keys from all elements to handle missing parameters)
    const headersSet = new Set<string>();
    arr.forEach(item => {
      Object.keys(item).forEach(k => headersSet.add(k));
    });
    const headers = Array.from(headersSet);

    let csv = headers.join(',') + '\n';
    
    arr.forEach(row => {
      const values = headers.map(header => {
        const val = row[header];
        if (val === undefined || val === null) return '';
        
        // Escape quotes
        let strVal = typeof val === 'object' ? JSON.stringify(val) : String(val);
        if (strVal.includes(',') || strVal.includes('"') || strVal.includes('\n')) {
          strVal = `"${strVal.replace(/"/g, '""')}"`;
        }
        return strVal;
      });
      csv += values.join(',') + '\n';
    });

    return csv;
  };

  const convertCsvToJson = (csv: string): string => {
    const lines = csv.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return '[]';

    // Parse header
    const headers = splitCsvLine(lines[0]);
    const list = [];

    for (let i = 1; i < lines.length; i++) {
      const cells = splitCsvLine(lines[i]);
      const item: any = {};
      headers.forEach((h, index) => {
        const cellVal = cells[index] || '';
        // Type coerce
        if (cellVal.toLowerCase() === 'true') item[h] = true;
        else if (cellVal.toLowerCase() === 'false') item[h] = false;
        else if (cellVal.toLowerCase() === 'null') item[h] = null;
        else if (!isNaN(Number(cellVal)) && cellVal !== '') item[h] = Number(cellVal);
        else item[h] = cellVal;
      });
      list.push(item);
    }

    return JSON.stringify(list, null, 2);
  };

  // Helper to split CSV line keeping quoted items grouped
  const splitCsvLine = (line: string): string[] => {
    const result = [];
    let cell = '';
    let inQuotes = false;
    
    for (let i = 0; i < line.length; i++) {
      const char = line[i];
      if (char === '"') {
        if (inQuotes && line[i + 1] === '"') {
          // Double quotes inside quotes
          cell += '"';
          i++; // skip next quote
        } else {
          inQuotes = !inQuotes;
        }
      } else if (char === ',' && !inQuotes) {
        result.push(cell.trim());
        cell = '';
      } else {
        cell += char;
      }
    }
    result.push(cell.trim());
    return result;
  };

  // --- 11. Base64 & URL Encoding Tools ---
  btnEncode?.addEventListener('click', () => {
    const val = encoderInput.value;
    const mode = encoderSelect.value;

    if (!val) {
      encoderOutput.value = '';
      return;
    }

    try {
      if (mode === 'b64enc') {
        // Handle unicode correctly using encodeURIComponent
        encoderOutput.value = btoa(encodeURIComponent(val).replace(/%([0-9A-F]{2})/g, (match, p1) => {
          return String.fromCharCode(parseInt(p1, 16));
        }));
      } else if (mode === 'b64dec') {
        encoderOutput.value = decodeURIComponent(atob(val).split('').map(c => {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
      } else if (mode === 'urlenc') {
        encoderOutput.value = encodeURIComponent(val);
      } else if (mode === 'urldec') {
        encoderOutput.value = decodeURIComponent(val);
      }
    } catch (err: any) {
      encoderOutput.value = `Conversion Error: ${err.message}`;
    }
  });

  // --- 12. Local Snippets History ---
  const saveHistoryItem = (jsonStr: string) => {
    if (!localStorage) return;
    
    try {
      const history = getLocalHistory();
      
      // Limit snippet saving length
      const snippetShort = jsonStr.length > 500 ? jsonStr.slice(0, 500) + '...' : jsonStr;
      
      // Avoid duplicate inputs
      const isDuplicate = history.some(item => item.raw === jsonStr);
      if (isDuplicate) return;

      const newItem = {
        id: Date.now(),
        raw: jsonStr,
        preview: snippetShort,
        size: jsonStr.length,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      };

      // Add to start, slice limit to 10
      history.unshift(newItem);
      const trimmedHistory = history.slice(0, 10);
      
      localStorage.setItem('json_history', JSON.stringify(trimmedHistory));
      renderHistory();
    } catch (e) {
      console.warn("Storage quota exceeded, history logging failed.");
    }
  };

  const getLocalHistory = (): any[] => {
    if (!localStorage) return [];
    const saved = localStorage.getItem('json_history');
    return saved ? JSON.parse(saved) : [];
  };

  const renderHistory = () => {
    if (!historyList) return;
    const history = getLocalHistory();

    if (history.length === 0) {
      historyList.innerHTML = `
        <div class="flex-1 flex items-center justify-center text-xs text-mute py-8 text-center px-4 font-sans select-none">
          No recent operations. Your formatting operations will be saved locally.
        </div>
      `;
      return;
    }

    let html = '';
    history.forEach(item => {
      // Escape preview for display
      const safePreview = escapeHtml(item.preview.replace(/\s+/g, ' '));
      const sizeStr = item.size > 1024 ? `${(item.size / 1024).toFixed(1)} KB` : `${item.size} B`;
      
      html += `
        <div class="p-3.5 hover:bg-canvas-soft-2 transition-colors flex flex-col gap-1.5 cursor-pointer relative group/item" data-id="${item.id}">
          <div class="flex items-center justify-between text-[10px] font-mono text-mute select-none">
            <span>${item.time}</span>
            <span>${sizeStr}</span>
          </div>
          <p class="text-[11px] font-mono text-body truncate break-all pr-5">${safePreview}</p>
          
          <!-- Quick actions -->
          <button class="delete-history-btn absolute right-2.5 top-1/2 -translate-y-1/2 opacity-0 group-hover/item:opacity-100 p-1 rounded hover:bg-canvas-soft text-mute hover:text-error transition-all cursor-pointer" data-id="${item.id}">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      `;
    });

    historyList.innerHTML = html;

    // Attach click listeners
    const items = historyList.querySelectorAll('[data-id]');
    items.forEach(item => {
      item.addEventListener('click', (e) => {
        // Prevent trigger on delete click
        if ((e.target as HTMLElement).closest('.delete-history-btn')) return;
        
        const id = parseInt(item.getAttribute('data-id') || '', 10);
        const match = history.find(h => h.id === id);
        if (match) {
          loadTextIntoEditor(match.raw);
        }
      });
    });

    // Attach delete listeners
    const deleteButtons = historyList.querySelectorAll('.delete-history-btn');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = parseInt(btn.getAttribute('data-id') || '', 10);
        deleteHistoryItem(id);
      });
    });
  };

  const deleteHistoryItem = (id: number) => {
    let history = getLocalHistory();
    history = history.filter(h => h.id !== id);
    localStorage.setItem('json_history', JSON.stringify(history));
    renderHistory();
  };

  btnClearHistory?.addEventListener('click', () => {
    localStorage.removeItem('json_history');
    renderHistory();
  });

  // Run on mount
  renderHistory();

  // Load initial URL parameters if they exist
  // Handles ?url=https://api.github.com
  const handleUrlParams = () => {
    const params = new URLSearchParams(window.location.search);
    const targetUrl = params.get('url');
    if (targetUrl) {
      // Pre-populate message
      if (jsonInput) jsonInput.value = `// Fetching data from: ${targetUrl}...\n`;
      updateLineCounter();
      
      fetch(targetUrl)
        .then(res => res.text())
        .then(text => {
          loadTextIntoEditor(text);
        })
        .catch(err => {
          if (jsonInput) jsonInput.value = `// Fetching failed:\n// ${err.message}\n`;
          updateLineCounter();
        });
    }
  };

  handleUrlParams();

  // Handle privacy policy popup links
  const modalPrivacyBtn = document.getElementById('footer-privacy-btn');
  const modalHowBtn = document.getElementById('footer-how-btn');
  
  modalPrivacyBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    alert("Privacy Audit:\n1. 100% Offline execution: No third-party network APIs are called.\n2. Zero telemetry: No GA tags, cookies, or metadata scripts.\n3. Source Inspection: Standard browser DOMParser and client bundlers execute everything locally.");
  });

  modalHowBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    alert("How it Works:\n- File inputs are parsed inside the local JS engine using native JSON.parse().\n- Custom Tree structure uses DOM string injections.\n- XML conversions run on browser DOMParser.\n- YAML conversions load client-side js-yaml modules.");
  });
</script>
