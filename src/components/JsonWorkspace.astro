              <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
            </div>
            <div class="flex px-3 py-0.5 text-body">
              <span class="w-10 text-right pr-2 text-mute select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">${lineNumB}</span>
              <span class="select-none text-mute mr-2.5 font-bold shrink-0">&nbsp;</span>
              <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
            </div>
          </div>
        `;
      } else if (item.type === 'added') {
        const lineNumB = String(item.lineB).padStart(4, ' ');
        html += `
          <div class="grid grid-cols-2 divide-x divide-hairline border-b border-hairline last:border-0 hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <div class="flex px-3 py-0.5 bg-canvas-soft">
              <span class="w-10 text-right pr-2 text-mute select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">&nbsp;</span>
            </div>
            <div class="flex px-3 py-0.5 diff-line-added">
              <span class="w-10 text-right pr-2 text-mute/50 select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">${lineNumB}</span>
              <span class="select-none mr-2.5 font-bold shrink-0">+</span>
              <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
            </div>
          </div>
        `;
      } else if (item.type === 'removed') {
        const lineNumA = String(item.lineA).padStart(4, ' ');
        html += `
          <div class="grid grid-cols-2 divide-x divide-hairline border-b border-hairline last:border-0 hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <div class="flex px-3 py-0.5 diff-line-removed">
              <span class="w-10 text-right pr-2 text-mute/50 select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">${lineNumA}</span>
              <span class="select-none mr-2.5 font-bold shrink-0">-</span>
              <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
            </div>
            <div class="flex px-3 py-0.5 bg-canvas-soft">
              <span class="w-10 text-right pr-2 text-mute select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">&nbsp;</span>
            </div>
          </div>
        `;
      } else if (item.type === 'modified') {
        const lineNumA = String(item.lineA).padStart(4, ' ');
        const lineNumB = String(item.lineB).padStart(4, ' ');
        const words = diffWords(item.valA, item.valB);

        let remHtml = '';
        words.a.forEach(w => {
          if (w.type === 'removed') {
            remHtml += `<mark class="diff-word-removed">${escapeHtml(w.val)}</mark>`;
          } else {
            remHtml += escapeHtml(w.val);
          }
        });

        let addHtml = '';
        words.b.forEach(w => {
          if (w.type === 'added') {
            addHtml += `<mark class="diff-word-added">${escapeHtml(w.val)}</mark>`;
          } else {
            addHtml += escapeHtml(w.val);
          }
        });

        html += `
          <div class="grid grid-cols-2 divide-x divide-hairline border-b border-hairline last:border-0 hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <div class="flex px-3 py-0.5 diff-line-removed">
              <span class="w-10 text-right pr-2 text-mute/50 select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">${lineNumA}</span>
              <span class="select-none mr-2.5 font-bold shrink-0">-</span>
              <span class="break-all whitespace-pre-wrap select-text">${remHtml}</span>
            </div>
            <div class="flex px-3 py-0.5 diff-line-added">
              <span class="w-10 text-right pr-2 text-mute/50 select-none border-r border-hairline mr-2 font-mono text-[11px] shrink-0">${lineNumB}</span>
              <span class="select-none mr-2.5 font-bold shrink-0">+</span>
              <span class="break-all whitespace-pre-wrap select-text">${addHtml}</span>
            </div>
          </div>
        `;
      }
    });

    diffOutputSplit.innerHTML = html;
  };

  // Render Unified view
  const renderUnifiedHtml = (processedItems: any[]) => {
    if (!diffOutputUnified) return;
    let html = '';

    processedItems.forEach(item => {
      if (item.type === 'normal') {
        const numLabel = `${item.lineA}➔${item.lineB}`.padStart(9, ' ');
        html += `
          <div class="flex px-3 py-0.5 hover:bg-canvas-soft-2 transition-colors select-text">
            <span class="text-mute select-none border-r border-hairline pr-2 mr-2.5 font-mono text-[11px] shrink-0 w-16 text-right">${numLabel}</span>
            <span class="select-none text-mute mr-2 font-bold shrink-0">&nbsp;</span>
            <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
          </div>
        `;
      } else if (item.type === 'added') {
        const numLabel = ` ➔${item.lineB}`.padStart(9, ' ');
        html += `
          <div class="flex px-3 py-0.5 diff-line-added hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <span class="text-mute/50 select-none border-r border-hairline pr-2 mr-2.5 font-mono text-[11px] shrink-0 w-16 text-right">${numLabel}</span>
            <span class="select-none mr-2 font-bold shrink-0">+</span>
            <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
          </div>
        `;
      } else if (item.type === 'removed') {
        const numLabel = `${item.lineA}➔ `.padStart(9, ' ');
        html += `
          <div class="flex px-3 py-0.5 diff-line-removed hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <span class="text-mute/50 select-none border-r border-hairline pr-2 mr-2.5 font-mono text-[11px] shrink-0 w-16 text-right">${numLabel}</span>
            <span class="select-none mr-2 font-bold shrink-0">-</span>
            <span class="break-all whitespace-pre-wrap select-text">${escapeHtml(item.val)}</span>
          </div>
        `;
      } else if (item.type === 'modified') {
        const numLabelA = `${item.lineA}➔ `.padStart(9, ' ');
        const numLabelB = ` ➔${item.lineB}`.padStart(9, ' ');
        const words = diffWords(item.valA, item.valB);

        let remHtml = '';
        words.a.forEach(w => {
          if (w.type === 'removed') {
            remHtml += `<mark class="diff-word-removed">${escapeHtml(w.val)}</mark>`;
          } else {
            remHtml += escapeHtml(w.val);
          }
        });

        let addHtml = '';
        words.b.forEach(w => {
          if (w.type === 'added') {
            addHtml += `<mark class="diff-word-added">${escapeHtml(w.val)}</mark>`;
          } else {
            addHtml += escapeHtml(w.val);
          }
        });

        html += `
          <div class="flex px-3 py-0.5 diff-line-removed hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <span class="text-mute/50 select-none border-r border-hairline pr-2 mr-2.5 font-mono text-[11px] shrink-0 w-16 text-right">${numLabelA}</span>
            <span class="select-none mr-2 font-bold shrink-0">-</span>
            <span class="break-all whitespace-pre-wrap select-text">${remHtml}</span>
          </div>
          <div class="flex px-3 py-0.5 diff-line-added hover:bg-canvas-soft-2 transition-colors diff-nav-target select-text">
            <span class="text-mute/50 select-none border-r border-hairline pr-2 mr-2.5 font-mono text-[11px] shrink-0 w-16 text-right">${numLabelB}</span>
            <span class="select-none mr-2 font-bold shrink-0">+</span>
            <span class="break-all whitespace-pre-wrap select-text">${addHtml}</span>
          </div>
        `;
      }
    });

    diffOutputUnified.innerHTML = html;
  };

  // Render tree diff in the UI
  const renderTreeDiffPanel = () => {
    if (!diffOutputTree || !diffTreeCache) return;
    const showOnlyChanges = chkDiffShowChanges.checked;
    diffOutputTree.innerHTML = renderTreeDiff(diffTreeCache, showOnlyChanges);
    setupTreeDiffCollapseListeners();
  };

  const setupTreeDiffCollapseListeners = () => {
    if (!diffOutputTree) return;

    // Expand/Collapse toggles
    const carets = diffOutputTree.querySelectorAll('.tree-caret');
    carets.forEach(caret => {
      caret.parentElement?.addEventListener('click', (e) => {
        e.stopPropagation();
        const groupNode = caret.closest('.tree-group');
        const children = groupNode?.querySelector('.tree-children');
        const footer = groupNode?.querySelector('.tree-footer');
        if (children) {
          if (children.classList.contains('hidden')) {
            children.classList.remove('hidden');
            footer?.classList.remove('hidden');
            caret.classList.add('rotate-90');
          } else {
            children.classList.add('hidden');
            footer?.classList.add('hidden');
            caret.classList.remove('rotate-90');
          }
        }
      });
    });

    // Copy Path triggers
    const pathButtons = diffOutputTree.querySelectorAll('.copy-path-btn');
    pathButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const path = btn.getAttribute('data-path') || '';
        navigator.clipboard.writeText(path).then(() => {
          const originalText = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('text-success');
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('text-success');
          }, 1000);
        });
      });
    });
  };

  // Jump and Scroll Navigation pointers
  const updateNavigatorTargets = () => {
    let activeContainer: HTMLElement | null = null;
    if (diffActiveView === 'split') activeContainer = diffOutputSplit;
    else if (diffActiveView === 'unified') activeContainer = diffOutputUnified;
    else if (diffActiveView === 'tree') activeContainer = diffOutputTree;

    if (!activeContainer) {
      diffTargets = [];
      diffCurrentNavIndex = -1;
      updateNavigatorButtons();
      return;
    }

    // Capture all elements marked as diff target changes
    diffTargets = Array.from(activeContainer.querySelectorAll('.diff-nav-target'));
    diffCurrentNavIndex = -1;
    updateNavigatorButtons();
  };

  const updateNavigatorButtons = () => {
    if (diffTargets.length > 0) {
      btnDiffPrev.disabled = false;
      btnDiffNext.disabled = false;
      diffNavStats!.textContent = `0 / ${diffTargets.length}`;
    } else {
      btnDiffPrev.disabled = true;
      btnDiffNext.disabled = true;
      diffNavStats!.textContent = `0 / 0`;
    }
  };

  const navigateDiff = (direction: 'prev' | 'next') => {
    if (diffTargets.length === 0) return;

    if (direction === 'next') {
      diffCurrentNavIndex++;
      if (diffCurrentNavIndex >= diffTargets.length) {
        diffCurrentNavIndex = 0; // Wrap around to start
      }
    } else {
      diffCurrentNavIndex--;
      if (diffCurrentNavIndex < 0) {
        diffCurrentNavIndex = diffTargets.length - 1; // Wrap to end
      }
    }

    const target = diffTargets[diffCurrentNavIndex] as HTMLElement;

    // Scroll container
    target.scrollIntoView({
      behavior: 'smooth',
      block: 'center',
      inline: 'nearest'
    });

    // Animate a quick flash color highlight
    target.classList.remove('diff-highlight-flash');
    void target.offsetWidth; // Force Reflow
    target.classList.add('diff-highlight-flash');

    // Expand parents if collapsed (specifically for Tree Diff View)
    if (diffActiveView === 'tree') {
      let parent = target.parentElement;
      while (parent && parent !== diffOutputTree) {
        if (parent.classList.contains('tree-children') && parent.classList.contains('hidden')) {
          parent.classList.remove('hidden');
          const groupNode = parent.closest('.tree-group');
          const footerNode = groupNode?.querySelector('.tree-footer');
          footerNode?.classList.remove('hidden');
          const caret = groupNode?.querySelector('.tree-caret');
          caret?.classList.add('rotate-90');
        }
        parent = parent.parentElement;
      }
    }

    diffNavStats!.textContent = `${diffCurrentNavIndex + 1} / ${diffTargets.length}`;
  };

  btnDiffPrev?.addEventListener('click', () => navigateDiff('prev'));
  btnDiffNext?.addEventListener('click', () => navigateDiff('next'));

  // --- 10. Converters (JSON ↔ YAML/XML/CSV) ---
  const updateConverterLabels = () => {
    const selection = converterSelect.value;
    if (selection === 'json2yaml') {
      converterInputLabel!.textContent = 'Raw JSON Input';
      converterOutputLabel!.textContent = 'YAML Output';
      converterInput.placeholder = '{\n  "name": "Jane"\n}';
    } else if (selection === 'yaml2json') {
      converterInputLabel!.textContent = 'YAML Input';
      converterOutputLabel!.textContent = 'JSON Output';
      converterInput.placeholder = 'name: Jane\nage: 28';
    } else if (selection === 'json2xml') {
      converterInputLabel!.textContent = 'Raw JSON Input';
      converterOutputLabel!.textContent = 'XML Output';
      converterInput.placeholder = '{\n  "name": "Jane"\n}';
    } else if (selection === 'xml2json') {
      converterInputLabel!.textContent = 'XML Input';
      converterOutputLabel!.textContent = 'JSON Output';
      converterInput.placeholder = '<root>\n  <name>Jane</name>\n</root>';
    } else if (selection === 'json2csv') {
      converterInputLabel!.textContent = 'Raw JSON Array Input';
      converterOutputLabel!.textContent = 'CSV Output';
      converterInput.placeholder = '[\n  {"id":1, "name":"Jane"},\n  {"id":2, "name":"John"}\n]';
    } else if (selection === 'csv2json') {
      converterInputLabel!.textContent = 'CSV Input';
      converterOutputLabel!.textContent = 'JSON Output';
      converterInput.placeholder = 'id,name\n1,Jane\n2,John';
    }
  };

  converterSelect?.addEventListener('change', updateConverterLabels);
  updateConverterLabels();

  btnConvert?.addEventListener('click', () => {
    const val = converterInput.value.trim();
    const mode = converterSelect.value;

    if (!val) {
      converterOutput.value = '';
      return;
    }

    try {
      if (mode === 'json2yaml') {
        const parsed = JSON.parse(val);
        converterOutput.value = yaml.dump(parsed);
      } else if (mode === 'yaml2json') {
        const parsed = yaml.load(val);
        converterOutput.value = JSON.stringify(parsed, null, 2);
      } else if (mode === 'json2xml') {
        const parsed = JSON.parse(val);
        // XML Root wrap
        converterOutput.value = '<?xml version="1.0" encoding="UTF-8"?>\n' + jsonToXml(parsed, 'root');
      } else if (mode === 'xml2json') {
        converterOutput.value = xmlToJson(val);
      } else if (mode === 'json2csv') {
        const parsed = JSON.parse(val);
        converterOutput.value = convertJsonToCsv(parsed);
      } else if (mode === 'csv2json') {
        converterOutput.value = convertCsvToJson(val);
      }
    } catch (err: any) {
      converterOutput.value = `Error: ${err.message}`;
    }
  });

  // Swap conversion direction (e.g., json2yaml ↔ yaml2json)
  const swapPairs: Record<string, string> = {
    'json2yaml': 'yaml2json', 'yaml2json': 'json2yaml',
    'json2xml': 'xml2json', 'xml2json': 'json2xml',
    'json2csv': 'csv2json', 'csv2json': 'json2csv',
  };
  btnConverterSwap?.addEventListener('click', () => {
    const current = converterSelect.value;
    const swapped = swapPairs[current];
    if (swapped) {
      converterSelect.value = swapped;
      // Swap input ↔ output content
      const tempVal = converterInput.value;
      converterInput.value = converterOutput.value;
      converterOutput.value = tempVal;
      updateConverterLabels();
    }
  });

  // Clear both converter fields
  btnConverterClear?.addEventListener('click', () => {
    converterInput.value = '';
    converterOutput.value = '';
  });

  // Copy converter output to clipboard
  btnConverterCopy?.addEventListener('click', async () => {
    const text = converterOutput.value;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      // Brief visual feedback
      btnConverterCopy.title = 'Copied!';
      setTimeout(() => { btnConverterCopy.title = 'Copy converted output'; }, 1500);
    } catch { /* clipboard API blocked */ }
  });

  // Download converter output as file
  btnConverterDownload?.addEventListener('click', () => {
    const text = converterOutput.value;
    if (!text) return;
    const mode = converterSelect.value;
    const extMap: Record<string, string> = {
      'json2yaml': 'yaml', 'yaml2json': 'json',
      'json2xml': 'xml', 'xml2json': 'json',
      'json2csv': 'csv', 'csv2json': 'json',
    };
    const ext = extMap[mode] || 'txt';
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `converted.${ext}`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // CSV Conversion Helpers
  const convertJsonToCsv = (obj: any): string => {
    const arr = Array.isArray(obj) ? obj : [obj];
    if (arr.length === 0) return '';
    
    // Extract headers (keys from all elements to handle missing parameters)
    const headersSet = new Set<string>();
    arr.forEach(item => {
      Object.keys(item).forEach(k => headersSet.add(k));
    });
    const headers = Array.from(headersSet);

    let csv = headers.join(',') + '\n';
    
    arr.forEach(row => {
      const values = headers.map(header => {
        const val = row[header];
        if (val === undefined || val === null) return '';
        
        // Escape quotes
        let strVal = typeof val === 'object' ? JSON.stringify(val) : String(val);
        if (strVal.includes(',') || strVal.includes('"') || strVal.includes('\n')) {
          strVal = `"${strVal.replace(/"/g, '""')}"`;
        }
        return strVal;
      });
      csv += values.join(',') + '\n';
    });

    return csv;
  };

  const convertCsvToJson = (csv: string): string => {
    const lines = csv.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return '[]';

    // Parse header
    const headers = splitCsvLine(lines[0]);
    const list = [];

    for (let i = 1; i < lines.length; i++) {
      const cells = splitCsvLine(lines[i]);
      const item: any = {};
      headers.forEach((h, index) => {
        const cellVal = cells[index] || '';
        // Type coerce
        if (cellVal.toLowerCase() === 'true') item[h] = true;
        else if (cellVal.toLowerCase() === 'false') item[h] = false;
        else if (cellVal.toLowerCase() === 'null') item[h] = null;
        else if (!isNaN(Number(cellVal)) && cellVal !== '') item[h] = Number(cellVal);
        else item[h] = cellVal;
      });
      list.push(item);
    }

    return JSON.stringify(list, null, 2);
  };

  // Helper to split CSV line keeping quoted items grouped
  const splitCsvLine = (line: string): string[] => {
    const result = [];
    let cell = '';
    let inQuotes = false;
    
    for (let i = 0; i < line.length; i++) {
      const char = line[i];
      if (char === '"') {
        if (inQuotes && line[i + 1] === '"') {
          // Double quotes inside quotes
          cell += '"';
          i++; // skip next quote
        } else {
          inQuotes = !inQuotes;
        }
      } else if (char === ',' && !inQuotes) {
        result.push(cell.trim());
        cell = '';
      } else {
        cell += char;
      }
    }
    result.push(cell.trim());
    return result;
  };

  // --- 11. Base64 & URL Encoding Tools ---
  btnEncode?.addEventListener('click', () => {
    const val = encoderInput.value;
    const mode = encoderSelect.value;

    if (!val) {
      encoderOutput.value = '';
      return;
    }

    try {
      if (mode === 'b64enc') {
        // Handle unicode correctly using encodeURIComponent
        encoderOutput.value = btoa(encodeURIComponent(val).replace(/%([0-9A-F]{2})/g, (match, p1) => {
          return String.fromCharCode(parseInt(p1, 16));
        }));
      } else if (mode === 'b64dec') {
        encoderOutput.value = decodeURIComponent(atob(val).split('').map(c => {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
      } else if (mode === 'urlenc') {
        encoderOutput.value = encodeURIComponent(val);
      } else if (mode === 'urldec') {
        encoderOutput.value = decodeURIComponent(val);
      }
    } catch (err: any) {
      encoderOutput.value = `Conversion Error: ${err.message}`;
    }
  });

  // Clear both encoder fields
  btnEncoderClear?.addEventListener('click', () => {
    encoderInput.value = '';
    encoderOutput.value = '';
  });

  // Copy encoder output to clipboard
  btnEncoderCopy?.addEventListener('click', async () => {
    const text = encoderOutput.value;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      btnEncoderCopy.title = 'Copied!';
      setTimeout(() => { btnEncoderCopy.title = 'Copy result'; }, 1500);
    } catch { /* clipboard API blocked */ }
  });

  // --- 12. Local Snippets History ---
  const saveHistoryItem = (jsonStr: string) => {
    if (!localStorage) return;
    
    try {
      const history = getLocalHistory();
      
      // Limit snippet saving length
      const snippetShort = jsonStr.length > 500 ? jsonStr.slice(0, 500) + '...' : jsonStr;
      
      // Avoid duplicate inputs
      const isDuplicate = history.some(item => item.raw === jsonStr);
      if (isDuplicate) return;

      const newItem = {
        id: Date.now(),
        raw: jsonStr,
        preview: snippetShort,
        size: jsonStr.length,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      };

      // Add to start, slice limit to 10
      history.unshift(newItem);
      const trimmedHistory = history.slice(0, 10);
      
      localStorage.setItem('json_history', JSON.stringify(trimmedHistory));
      renderHistory();
    } catch (e) {
      console.warn("Storage quota exceeded, history logging failed.");
    }
  };

  const getLocalHistory = (): any[] => {
    if (!localStorage) return [];
    const saved = localStorage.getItem('json_history');
    return saved ? JSON.parse(saved) : [];
  };

  const renderHistory = () => {
    if (!historyList) return;
    const history = getLocalHistory();

    if (history.length === 0) {
      historyList.innerHTML = `
        <div class="flex-1 flex items-center justify-center text-xs text-mute py-8 text-center px-4 font-sans select-none">
          No recent operations. Your formatting operations will be saved locally.
        </div>
      `;
      return;
    }

    let html = '';
    history.forEach(item => {
      // Escape preview for display
      const safePreview = escapeHtml(item.preview.replace(/\s+/g, ' '));
      const sizeStr = item.size > 1024 ? `${(item.size / 1024).toFixed(1)} KB` : `${item.size} B`;
      
      html += `
        <div class="p-3.5 hover:bg-canvas-soft-2 transition-colors flex flex-col gap-1.5 cursor-pointer relative group/item" data-id="${item.id}">
          <div class="flex items-center justify-between text-[10px] font-mono text-mute select-none">
            <span>${item.time}</span>
            <span>${sizeStr}</span>
          </div>
          <p class="text-[11px] font-mono text-body truncate break-all pr-5">${safePreview}</p>
          
          <!-- Quick actions -->
          <button class="delete-history-btn absolute right-2.5 top-1/2 -translate-y-1/2 opacity-0 group-hover/item:opacity-100 p-1 rounded hover:bg-canvas-soft text-mute hover:text-error transition-all cursor-pointer" data-id="${item.id}">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      `;
    });

    historyList.innerHTML = html;

    // Attach click listeners
    const items = historyList.querySelectorAll('[data-id]');
    items.forEach(item => {
      item.addEventListener('click', (e) => {
        // Prevent trigger on delete click
        if ((e.target as HTMLElement).closest('.delete-history-btn')) return;
        
        const id = parseInt(item.getAttribute('data-id') || '', 10);
        const match = history.find(h => h.id === id);
        if (match) {
          loadTextIntoEditor(match.raw);
        }
      });
    });

    // Attach delete listeners
    const deleteButtons = historyList.querySelectorAll('.delete-history-btn');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = parseInt(btn.getAttribute('data-id') || '', 10);
        deleteHistoryItem(id);
      });
    });
  };

  const deleteHistoryItem = (id: number) => {
    let history = getLocalHistory();
    history = history.filter(h => h.id !== id);
    localStorage.setItem('json_history', JSON.stringify(history));
    renderHistory();
  };

  btnClearHistory?.addEventListener('click', () => {
    localStorage.removeItem('json_history');
    renderHistory();
  });

  // Run on mount
  renderHistory();

  // Load initial URL parameters if they exist
  // Handles ?url=https://api.github.com
  const handleUrlParams = () => {
    const params = new URLSearchParams(window.location.search);
    const targetUrl = params.get('url');
    if (targetUrl) {
      // Pre-populate message
      if (jsonInput) jsonInput.value = `// Fetching data from: ${targetUrl}...\n`;
      updateLineCounter();
      
      fetch(targetUrl)
        .then(res => res.text())
        .then(text => {
          loadTextIntoEditor(text);
        })
        .catch(err => {
          if (jsonInput) jsonInput.value = `// Fetching failed:\n// ${err.message}\n`;
          updateLineCounter();
        });
    }
  };

  handleUrlParams();

  // Handle privacy policy popup links
  const modalPrivacyBtn = document.getElementById('footer-privacy-btn');
  const modalHowBtn = document.getElementById('footer-how-btn');
  
  modalPrivacyBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    alert("Privacy Audit:\n1. 100% Offline execution: No third-party network APIs are called.\n2. Zero telemetry: No GA tags, cookies, or metadata scripts.\n3. Source Inspection: Standard browser DOMParser and client bundlers execute everything locally.");
  });

  modalHowBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    alert("How it Works:\n- File inputs are parsed inside the local JS engine using native JSON.parse().\n- Custom Tree structure uses DOM string injections.\n- XML conversions run on browser DOMParser.\n- YAML conversions load client-side js-yaml modules.");
  });
</script>
