---
---
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex-1 flex flex-col gap-6">
  <!-- Tabs Navigation -->
  <div class="relative flex border-b border-hairline transition-colors duration-200">
    <!-- Mesh Gradient accent line under tabs -->
    <div class="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-cyan to-violet w-0 transition-all duration-300" id="tab-indicator"></div>
    
    <nav class="flex gap-2 sm:gap-6 -mb-[1px]">
      <button 
        data-target="panel-formatter" 
        class="tab-btn pb-3.5 px-1 font-sans font-medium text-sm text-link border-b-2 border-link cursor-pointer transition-colors"
      >
        Formatter & Validator
      </button>
      <button 
        data-target="panel-diff" 
        class="tab-btn pb-3.5 px-1 font-sans font-medium text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors"
      >
        Diff Compare
      </button>
      <button 
        data-target="panel-converters" 
        class="tab-btn pb-3.5 px-1 font-sans font-medium text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors"
      >
        Converters
      </button>
      <button 
        data-target="panel-encoder" 
        class="tab-btn pb-3.5 px-1 font-sans font-medium text-sm text-body hover:text-ink border-b-2 border-transparent cursor-pointer transition-colors"
      >
        Base64 & URL
      </button>
    </nav>
  </div>

  <!-- Workspace Cards Area -->
  <div class="flex-1 flex flex-col min-h-[600px] lg:flex-row gap-6">
    <!-- Main Workspace Console -->
    <div class="flex-1 bg-canvas border border-hairline shadow-level-3 rounded-xl overflow-hidden flex flex-col transition-all duration-200">
      
      <!-- Panel 1: Formatter & Linter -->
      <div id="panel-formatter" class="workspace-panel flex-1 flex flex-col">
        <!-- Editor Header toolbar -->
        <div class="border-b border-hairline bg-canvas-soft-2 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs select-none">
          <div class="flex items-center gap-2 flex-wrap">
            <!-- Upload -->
            <label class="px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body font-medium shadow-level-2 transition-all cursor-pointer flex items-center gap-1.5">
              <input type="file" id="file-uploader" class="hidden" accept=".json,.txt" />
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              Upload JSON
            </label>
            <!-- Sample JSON -->
            <div class="relative group/sample">
              <button class="px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body font-medium shadow-level-2 transition-all cursor-pointer flex items-center gap-1">
                Load Sample
                <svg class="w-3 h-3 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-1 hidden group-hover/sample:block w-40 rounded-lg border border-hairline bg-canvas shadow-level-5 py-1 z-30">
                <button data-sample="simple" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Simple Object</button>
                <button data-sample="nested" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Nested Array</button>
                <button data-sample="config" class="sample-load-btn w-full px-3 py-1.5 text-left hover:bg-canvas-soft-2 transition-colors cursor-pointer">Config File</button>
              </div>
            </div>
            <!-- Clear -->
            <button id="btn-clear" class="px-2.5 py-1.5 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-error font-medium shadow-level-2 transition-all cursor-pointer">
              Clear
            </button>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-mute font-medium">Indent:</span>
            <select id="indent-select" class="px-2 py-1 rounded border border-hairline bg-canvas text-body focus:outline-none cursor-pointer">
              <option value="2">2 Spaces</option>
              <option value="3">3 Spaces</option>
              <option value="4" selected>4 Spaces</option>
              <option value="tab">Tabs</option>
            </select>
          </div>
        </div>

        <!-- Editor Split Screen -->
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
          <!-- Left: Input Area -->
          <div class="flex flex-col relative h-[450px] lg:h-auto min-h-[350px]">
            <!-- File Drag/Drop Overlay -->
            <div id="drop-zone" class="absolute inset-0 bg-canvas/90 border-2 border-dashed border-link z-20 hidden items-center justify-center flex-col gap-3 transition-opacity duration-200">
              <div class="w-12 h-12 rounded-full bg-link-bg-soft flex items-center justify-center text-link">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <div class="text-center">
                <p class="font-sans font-semibold text-sm text-ink">Drop your JSON file here</p>
                <p class="text-xs text-mute mt-0.5">Supports .json or plain text format</p>
              </div>
            </div>

            <!-- Custom Editor container with line numbers -->
            <div class="flex-1 flex overflow-hidden bg-canvas relative">
              <!-- Line Numbers Column -->
              <div id="editor-line-numbers" class="w-10 py-4 font-mono text-[13px] text-mute select-none border-r border-hairline bg-canvas-soft text-right pr-2 leading-6 overflow-hidden">
                <div>1</div>
              </div>
              <!-- Text Area -->
              <textarea 
                id="json-input" 
                class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-transparent"
                placeholder='Paste or drag raw JSON text here... (e.g. {"status":"secure"})'
                spellcheck="false"
              ></textarea>
            </div>
            
            <!-- Error Banner -->
            <div id="error-banner" class="hidden border-t border-error-soft bg-error-soft/10 text-error px-4 py-3 text-xs flex items-start gap-2.5 transition-all">
              <svg class="w-4 h-4 text-error shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p class="font-semibold" id="error-title">Syntax Error</p>
                <p class="text-[11px] mt-0.5" id="error-desc"></p>
              </div>
              <button id="btn-fix-error" class="hidden shrink-0 px-2 py-1 rounded bg-error text-[10px] text-white font-medium hover:bg-error-deep cursor-pointer transition-colors">
                Go to Line
              </button>
            </div>

            <!-- Bottom Left Status bar -->
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex items-center justify-between text-[11px] text-mute font-mono select-none">
              <span id="editor-stats">Lines: 1 · Chars: 0</span>
              <span class="text-caption-mono text-mute">JSON Input</span>
            </div>
          </div>

          <!-- Right: Output Area -->
          <div class="flex flex-col relative h-[450px] lg:h-auto min-h-[350px]">
            
            <!-- Output Sub Tabs / Controls -->
            <div class="border-b border-hairline bg-canvas-soft px-4 py-2 flex items-center justify-between text-xs select-none">
              <!-- Sub Panel selector -->
              <div class="flex border border-hairline rounded-md bg-canvas overflow-hidden shadow-level-1">
                <button data-view="formatted" class="output-view-btn px-3 py-1.5 font-medium text-ink bg-canvas-soft-2 transition-colors cursor-pointer border-r border-hairline">Formatted</button>
                <button data-view="tree" class="output-view-btn px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer border-r border-hairline">Tree View</button>
                <button data-view="minified" class="output-view-btn px-3 py-1.5 font-medium text-body hover:text-ink transition-colors cursor-pointer">Minified</button>
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-2">
                <button id="btn-copy" class="p-1.5 rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer" title="Copy output">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-5 4h6m-6 4h6m-2 4h4" />
                  </svg>
                </button>
                <button id="btn-download" class="p-1.5 rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 text-body hover:text-ink font-medium shadow-level-2 transition-all cursor-pointer" title="Download formatted file">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Output Search toolbar (conditional - only for Tree view) -->
            <div id="tree-search-bar" class="hidden border-b border-hairline bg-canvas px-4 py-2 flex items-center justify-between gap-3 select-none">
              <div class="relative flex-1">
                <input 
                  type="text" 
                  id="tree-search" 
                  class="w-full pl-7 pr-3 py-1 text-xs rounded border border-hairline bg-canvas-soft focus:outline-none placeholder:text-mute focus:bg-canvas"
                  placeholder="Filter keys or values..."
                />
                <svg class="w-3.5 h-3.5 text-mute absolute left-2 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <div class="flex items-center gap-1.5">
                <button id="btn-tree-expand" class="px-2 py-1 rounded border border-hairline text-[10px] font-medium bg-canvas hover:bg-canvas-soft-2 cursor-pointer">Expand All</button>
                <button id="btn-tree-collapse" class="px-2 py-1 rounded border border-hairline text-[10px] font-medium bg-canvas hover:bg-canvas-soft-2 cursor-pointer">Collapse All</button>
              </div>
            </div>

            <!-- Display subviews -->
            <div class="flex-1 overflow-auto bg-canvas relative p-4" id="output-pane">
              <!-- Formatted Raw text view -->
              <pre id="output-formatted" class="font-mono text-[13px] text-ink leading-6 select-all break-all whitespace-pre-wrap"></pre>
              
              <!-- Tree view container -->
              <div id="output-tree" class="hidden font-mono text-[13px] text-ink leading-6 select-none select-tree-container"></div>
              
              <!-- Minified text view -->
              <textarea id="output-minified" class="hidden w-full h-full font-mono text-[13px] text-ink leading-6 bg-transparent border-none focus:outline-none select-all resize-none" readonly></textarea>
            </div>

            <!-- Bottom Right Status bar -->
            <div class="border-t border-hairline px-4 py-2 bg-canvas-soft-2 flex items-center justify-between text-[11px] text-mute font-mono select-none">
              <span id="output-stats">Size: 0 B</span>
              <span class="text-caption-mono text-mute">JSON Output</span>
            </div>
          </div>
        </div>

        <!-- Format button at center bottom -->
        <div class="border-t border-hairline p-4 bg-canvas flex items-center justify-center gap-4">
          <button id="btn-format" class="px-6 py-2.5 rounded-full bg-primary hover:opacity-90 text-on-primary font-sans font-semibold text-sm shadow-level-4 transition-all duration-200 cursor-pointer select-none">
            Beautify JSON
          </button>
          <button id="btn-minify" class="px-5 py-2.5 rounded-full bg-canvas border border-hairline hover:bg-canvas-soft-2 text-ink font-sans font-medium text-sm shadow-level-2 transition-all duration-200 cursor-pointer select-none">
            Minify JSON
          </button>
        </div>
      </div>

      <!-- Panel 2: Diff Compare -->
      <div id="panel-diff" class="workspace-panel flex-1 flex flex-col hidden">
        <div class="border-b border-hairline bg-canvas-soft-2 px-4 py-2.5 flex items-center justify-between text-xs select-none">
          <span class="font-sans font-semibold text-body">Side-by-Side JSON Diff Tool</span>
          <button id="btn-compare" class="px-4 py-1.5 rounded bg-primary hover:opacity-90 text-on-primary font-medium shadow-level-2 transition-all cursor-pointer">
            Compare JSON
          </button>
        </div>
        
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline min-h-[400px]">
          <!-- JSON A Input -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="diff-input-a" 
              class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-canvas"
              placeholder='Paste Original JSON A here...'
              spellcheck="false"
            ></textarea>
            <div class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Original JSON A</div>
          </div>
          <!-- JSON B Input -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="diff-input-b" 
              class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-canvas"
              placeholder='Paste Modified JSON B here...'
              spellcheck="false"
            ></textarea>
            <div class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Modified JSON B</div>
          </div>
        </div>

        <!-- Diff output display -->
        <div id="diff-output-panel" class="hidden border-t border-hairline bg-canvas-soft flex flex-col flex-1 max-h-[400px]">
          <div class="border-b border-hairline px-4 py-2 bg-canvas-soft-2 text-xs font-semibold text-body">Comparison Results</div>
          <div class="flex-1 overflow-auto p-4 font-mono text-[13px] leading-6 bg-canvas" id="diff-output-container">
            <!-- Diff lines will generate here -->
          </div>
        </div>
      </div>

      <!-- Panel 3: Converters -->
      <div id="panel-converters" class="workspace-panel flex-1 flex flex-col hidden">
        <div class="border-b border-hairline bg-canvas-soft-2 px-4 py-2.5 flex items-center justify-between text-xs select-none">
          <div class="flex items-center gap-3">
            <span class="font-sans font-semibold text-body">Convert Formats:</span>
            <select id="converter-select" class="px-2.5 py-1 rounded border border-hairline bg-canvas text-body focus:outline-none cursor-pointer">
              <option value="json2yaml">JSON to YAML</option>
              <option value="yaml2json">YAML to JSON</option>
              <option value="json2xml">JSON to XML</option>
              <option value="xml2json">XML to JSON</option>
              <option value="json2csv">JSON to CSV</option>
              <option value="csv2json">CSV to JSON</option>
            </select>
          </div>
          <button id="btn-convert" class="px-4 py-1.5 rounded bg-primary hover:opacity-90 text-on-primary font-medium shadow-level-2 transition-all cursor-pointer">
            Run Convert
          </button>
        </div>

        <!-- Converter Split screen -->
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
          <!-- Input -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="converter-input" 
              class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-canvas"
              placeholder='Paste input text here...'
              spellcheck="false"
            ></textarea>
            <div id="converter-input-label" class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Source Input</div>
          </div>
          <!-- Output -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="converter-output" 
              class="flex-1 p-4 font-mono text-[13px] text-ink leading-6 bg-canvas-soft focus:outline-none resize-none overflow-y-auto leading-6"
              placeholder='Converted output will appear here...'
              readonly
            ></textarea>
            <div id="converter-output-label" class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Converted Output</div>
          </div>
        </div>
      </div>

      <!-- Panel 4: Encoder/Decoder -->
      <div id="panel-encoder" class="workspace-panel flex-1 flex flex-col hidden">
        <div class="border-b border-hairline bg-canvas-soft-2 px-4 py-2.5 flex items-center justify-between text-xs select-none">
          <div class="flex items-center gap-3">
            <span class="font-sans font-semibold text-body">Select Operation:</span>
            <select id="encoder-select" class="px-2.5 py-1 rounded border border-hairline bg-canvas text-body focus:outline-none cursor-pointer">
              <option value="b64enc">Base64 Encode</option>
              <option value="b64dec">Base64 Decode</option>
              <option value="urlenc">URL Encode</option>
              <option value="urldec">URL Decode</option>
            </select>
          </div>
          <button id="btn-encode" class="px-4 py-1.5 rounded bg-primary hover:opacity-90 text-on-primary font-medium shadow-level-2 transition-all cursor-pointer">
            Execute
          </button>
        </div>

        <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
          <!-- Input -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="encoder-input" 
              class="flex-1 p-4 font-mono text-[13px] text-ink placeholder:text-mute focus:outline-none resize-none overflow-y-auto leading-6 bg-canvas"
              placeholder='Paste source text here...'
              spellcheck="false"
            ></textarea>
            <div class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Plain/Encoded Input</div>
          </div>
          <!-- Output -->
          <div class="flex flex-col relative h-[300px] lg:h-auto">
            <textarea 
              id="encoder-output" 
              class="flex-1 p-4 font-mono text-[13px] text-ink leading-6 bg-canvas-soft focus:outline-none resize-none overflow-y-auto leading-6"
              placeholder='Result will appear here...'
              readonly
            ></textarea>
            <div class="border-t border-hairline px-4 py-1.5 bg-canvas-soft-2 text-[10px] text-mute font-mono">Result Output</div>
          </div>
        </div>
      </div>
      
    </div>

    <!-- Collapsible Snippets Sidebar -->
    <div class="w-full lg:w-72 flex flex-col gap-6">
      <!-- Info security shield panel -->
      <div class="bg-canvas border border-hairline shadow-level-3 rounded-xl p-5 flex flex-col gap-3 transition-colors duration-200">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-link-bg-soft flex items-center justify-center text-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <span class="font-sans font-semibold text-sm text-ink">100% Client-Side Sandbox</span>
        </div>
        <p class="text-xs text-mute leading-relaxed">
          Online formatters often process data on servers, risking credentials leak. In this sandbox, **all processing happens in your browser locally**. Your content is never transmitted across the network.
        </p>
      </div>

      <!-- History Logger -->
      <div class="bg-canvas border border-hairline shadow-level-3 rounded-xl flex-1 flex flex-col max-h-[400px] lg:max-h-none overflow-hidden transition-colors duration-200">
        <div class="border-b border-hairline px-5 py-4 bg-canvas-soft-2 flex items-center justify-between select-none">
          <span class="font-sans font-semibold text-sm text-ink">Recent Snippets</span>
          <button id="btn-clear-history" class="text-[10px] text-mute hover:text-error transition-colors cursor-pointer">Clear All</button>
        </div>
        <!-- History items list -->
        <div id="history-list" class="flex-1 overflow-y-auto divide-y divide-hairline flex flex-col">
          <!-- Dynamically populated -->
          <div class="flex-1 flex items-center justify-center text-xs text-mute py-8 text-center px-4 font-sans select-none">
            No recent operations. Your formatting operations will be saved locally.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import yaml from 'js-yaml';
  import { renderJsonTree } from '../utils/TreeViewer.js';
  import { jsonToXml, xmlToJson } from '../utils/XmlConverter.js';

  // --- Theme/Layout Elements ---
  const tabButtons = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.workspace-panel');
  const tabIndicator = document.getElementById('tab-indicator');

  // --- Formatter Elements ---
  const jsonInput = document.getElementById('json-input') as HTMLTextAreaElement;
  const lineNumbers = document.getElementById('editor-line-numbers');
  const indentSelect = document.getElementById('indent-select') as HTMLSelectElement;
  const errorBanner = document.getElementById('error-banner');
  const errorTitle = document.getElementById('error-title');
  const errorDesc = document.getElementById('error-desc');
  const btnFixError = document.getElementById('btn-fix-error');
  const statsLabel = document.getElementById('editor-stats');
  const outputStats = document.getElementById('output-stats');
  const outputPane = document.getElementById('output-pane');
  const outputFormatted = document.getElementById('output-formatted');
  const outputTree = document.getElementById('output-tree');
  const outputMinified = document.getElementById('output-minified') as HTMLTextAreaElement;
  
  const btnFormat = document.getElementById('btn-format');
  const btnMinify = document.getElementById('btn-minify');
  const btnClear = document.getElementById('btn-clear');
  const btnCopy = document.getElementById('btn-copy');
  const btnDownload = document.getElementById('btn-download');
  const fileUploader = document.getElementById('file-uploader') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone');

  const sampleButtons = document.querySelectorAll('.sample-load-btn');
  const viewButtons = document.querySelectorAll('.output-view-btn');
  const treeSearchBar = document.getElementById('tree-search-bar');
  const treeSearch = document.getElementById('tree-search') as HTMLInputElement;
  const btnTreeExpand = document.getElementById('btn-tree-expand');
  const btnTreeCollapse = document.getElementById('btn-tree-collapse');

  // --- Diff Elements ---
  const diffInputA = document.getElementById('diff-input-a') as HTMLTextAreaElement;
  const diffInputB = document.getElementById('diff-input-b') as HTMLTextAreaElement;
  const btnCompare = document.getElementById('btn-compare');
  const diffOutputPanel = document.getElementById('diff-output-panel');
  const diffOutputContainer = document.getElementById('diff-output-container');

  // --- Converter Elements ---
  const converterSelect = document.getElementById('converter-select') as HTMLSelectElement;
